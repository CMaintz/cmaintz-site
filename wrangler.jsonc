// Worker config. Astro's Cloudflare adapter merges this into dist/server/wrangler.json.
{
  "name": "cmaintz-site",
  "compatibility_date": "2026-09-25",
  // Astro's handler wrapped with Markdown content negotiation (Accept: text/markdown).
  "main": "./src/worker.ts",
  // Pages go through the Worker first so it can negotiate; static files don't.
  "assets": {
    "binding": "ASSETS",
    "run_worker_first": ["/*", "!/_astro/*", "!/og/*", "!/img/*", "!/media/*", "!/doom/*", "!/pagefind/*"]
  },
  // www.maintz.dev is handled by redirect-www/ (a separate redirect Worker).
  // Custom domains: Cloudflare creates the DNS records and TLS certificates on deploy.
  "routes": [{ "pattern": "maintz.dev", "custom_domain": true }],
  // PR previews (ci.yml) are served at pr-<n>-cmaintz-site.<subdomain>.workers.dev.
  "preview_urls": true,
  // Contact form: at most 3 messages a minute per IP (src/pages/api/contact.ts).
  // namespace_id is any number unique within the Cloudflare account.
  // Site assistant (src/pages/api/assistant.ts): per IP, plus one shared key as a site-wide ceiling.
  "ratelimits": [
    { "name": "CONTACT_LIMITER", "namespace_id": "1001", "simple": { "limit": 3, "period": 60 } },
    { "name": "ASSISTANT_LIMITER", "namespace_id": "1002", "simple": { "limit": 8, "period": 60 } },
    { "name": "ASSISTANT_GLOBAL_LIMITER", "namespace_id": "1003", "simple": { "limit": 40, "period": 60 } }
  ]
}
