---
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import PreviewShell from '../layouts/PreviewShell.astro';
import { homeData } from '../lib/home';
import { site } from '../data/site';

const d = await homeData();
---

<PreviewShell style="bold" title="Christoffer Maintz - bold preview">
  <div class="bd">
    <header class="top">
      <a href="/bold" class="mark">CM<span>.</span></a>
      <nav><a href="/about">About</a><a href="/projects">Work</a><a href="/blog">Blog</a><a class="pill" href="/contact">Let’s talk</a></nav>
    </header>

    <main>
      <section class="hero">
        <p class="eyebrow"><span class="dot"></span>{d.status}</p>
        <h1><span class="line">Ship faster.</span> <span class="line grad">Break less.</span></h1>
        <p class="lede">{d.lede}</p>
        <div class="ctas"><a class="btn primary" href="/projects">See the work</a><a class="btn" href="/services">Services</a></div>
        <div class="orb" aria-hidden="true"></div>
      </section>

      <section class="focus">
        {d.focus.map((f, i) => (
          <div class="f"><span class="n">0{i + 1}</span><h3>{f.title}</h3><p>{f.body}</p></div>
        ))}
      </section>

      <section class="work">
        <h2>Selected work</h2>
        <div class="cards">
          {d.projects.slice(0, 5).map((p, i) => (
            <a class:list={['card', { wide: i === 0 }]} href={`/projects/${p.id}`} data-tilt>
              <span class="cat">{p.category}</span>
              <h3>{p.title}</h3>
              <p>{i === 0 ? p.summary : p.tagline}</p>
              <span class="stack">{p.stack.join(' / ')}</span>
            </a>
          ))}
        </div>
      </section>

      <section class="posts">
        <h2>Writing</h2>
        {d.posts.map((p) => (
          <a class="post" href={`/blog/${p.id}`}><span>{p.title}</span><span class="m">{p.minutes} min →</span></a>
        ))}
      </section>

      <section class="cta">
        <h2>{d.ctaTitle}</h2>
        <a class="mail" href={`mailto:${site.email}`}>{site.email}</a>
      </section>
    </main>
  </div>
</PreviewShell>

<script>
  // Bounded tilt on fine pointers only; static on touch and reduced motion.
  const MAX = 6;
  const canTilt = matchMedia('(pointer: fine)').matches && !matchMedia('(prefers-reduced-motion: reduce)').matches;

  function tilt(el: HTMLElement, e: PointerEvent) {
    const r = el.getBoundingClientRect();
    const x = (e.clientX - r.left) / r.width - 0.5;
    const y = (e.clientY - r.top) / r.height - 0.5;
    el.style.transform = `perspective(900px) rotateY(${x * MAX}deg) rotateX(${-y * MAX}deg) translateZ(0)`;
    el.style.setProperty('--mx', `${(x + 0.5) * 100}%`);
    el.style.setProperty('--my', `${(y + 0.5) * 100}%`);
  }

  function bindTilt(el: HTMLElement) {
    el.addEventListener('pointermove', (e) => tilt(el, e));
    el.addEventListener('pointerleave', () => (el.style.transform = ''));
  }

  if (canTilt) document.querySelectorAll<HTMLElement>('[data-tilt]').forEach(bindTilt);
</script>

<style>
  .bd {
    --bg: #ffffff; --fg: #0b0b0f; --dim: #5a5a66; --line: #e6e6ee; --card: #f5f5fa; --accent: #4f46e5; --accent2: #db2777;
    background: var(--bg); color: var(--fg);
    font: 400 17px/1.6 'Inter', system-ui, sans-serif;
    min-height: 100vh; overflow-x: hidden;
    padding: 0 clamp(1rem, 4vw, 3rem) 6rem;
  }
  @media (prefers-color-scheme: dark) {
    .bd { --bg: #0b0b0f; --fg: #f2f2f5; --dim: #9a9aa8; --line: #22222c; --card: #13131a; --accent: #8aa2ff; --accent2: #f472b6; }
  }
  .bd a { color: inherit; text-decoration: none; }
  .top, main { max-width: 76rem; margin: 0 auto; }
  .top { display: flex; justify-content: space-between; align-items: center; padding-block: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .mark { font: 700 1.6rem 'Space Grotesk', sans-serif; }
  .mark span { color: var(--accent); }
  .top nav { display: flex; gap: 1.5rem; align-items: center; font-weight: 500; font-size: 0.95rem; }
  .pill { background: var(--fg); color: var(--bg) !important; padding: 0.5rem 1rem; border-radius: 999px; }
  .hero { position: relative; padding-block: clamp(4rem, 12vw, 9rem) 4rem; }
  .eyebrow { display: inline-flex; align-items: center; gap: 0.5rem; font-weight: 500; font-size: 0.85rem; padding: 0.35rem 0.8rem; border: 1px solid var(--line); border-radius: 999px; margin: 0 0 2rem; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: #22c55e; }
  h1 { font: 700 clamp(3.2rem, 11vw, 8.5rem)/0.92 'Space Grotesk', sans-serif; letter-spacing: -0.05em; margin: 0 0 2rem; position: relative; z-index: 1; }
  .line { display: block; }
  .grad { background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; }
  .lede { font-size: 1.25rem; color: var(--dim); max-width: 38rem; margin: 0; position: relative; z-index: 1; }
  .ctas { display: flex; gap: 1rem; margin-top: 2.2rem; flex-wrap: wrap; position: relative; z-index: 1; }
  .btn { padding: 0.9rem 1.6rem; border-radius: 999px; border: 1px solid var(--line); font-weight: 500; transition: transform 200ms ease; }
  .btn:hover { transform: translateY(-2px); }
  .btn.primary { background: var(--accent); border-color: var(--accent); color: #fff; }
  @media (prefers-color-scheme: dark) { .btn.primary { color: #0b0b0f; } }
  .orb { position: absolute; right: -8rem; top: 2rem; width: 32rem; height: 32rem; border-radius: 50%; background: radial-gradient(circle at 30% 30%, var(--accent), transparent 60%), radial-gradient(circle at 70% 70%, var(--accent2), transparent 55%); filter: blur(60px); opacity: 0.35; pointer-events: none; }
  @media (prefers-reduced-motion: no-preference) { .orb { animation: drift 14s ease-in-out infinite alternate; } }
  @keyframes drift { to { transform: translate(-4rem, 3rem) scale(1.1); } }
  .focus { display: grid; grid-template-columns: repeat(4, 1fr); gap: 1rem; margin-block: 2rem 6rem; }
  .f { padding: 1.5rem; border-top: 3px solid var(--fg); }
  .n { font: 700 0.85rem 'Space Grotesk', sans-serif; color: var(--accent); }
  .f h3 { font: 700 1.2rem 'Space Grotesk', sans-serif; margin: 0.4rem 0; }
  .f p { color: var(--dim); font-size: 0.95rem; margin: 0; }
  h2 { font: 700 clamp(2rem, 5vw, 3.5rem)/1 'Space Grotesk', sans-serif; letter-spacing: -0.04em; margin: 0 0 2rem; }
  .cards { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .card {
    display: grid; gap: 0.7rem; align-content: start; padding: 1.8rem; border-radius: 1.2rem;
    background: radial-gradient(400px circle at var(--mx, 50%) var(--my, 50%), color-mix(in srgb, var(--accent) 14%, transparent), transparent 60%), var(--card);
    border: 1px solid var(--line); transition: transform 150ms ease-out, border-color 200ms; will-change: transform;
  }
  .card:hover { border-color: var(--accent); }
  .card.wide { grid-column: span 2; }
  .cat { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.1em; color: var(--accent); font-weight: 500; }
  .card h3 { font: 700 1.7rem 'Space Grotesk', sans-serif; letter-spacing: -0.03em; margin: 0; }
  .card.wide h3 { font-size: 2.4rem; }
  .card p { margin: 0; color: var(--dim); }
  .stack { font-size: 0.8rem; color: var(--dim); }
  .posts { margin-top: 6rem; }
  .post { display: flex; justify-content: space-between; gap: 1rem; padding: 1.4rem 0; border-bottom: 1px solid var(--line); font: 500 clamp(1.2rem, 2.5vw, 1.7rem) 'Space Grotesk', sans-serif; letter-spacing: -0.02em; transition: padding 200ms ease, color 200ms; }
  .post:hover { padding-left: 1rem; color: var(--accent); }
  .m { color: var(--dim); font: 400 0.9rem 'Inter', sans-serif; white-space: nowrap; align-self: center; }
  .cta { margin-top: 7rem; text-align: center; }
  .mail { font: 700 clamp(1.4rem, 5vw, 3.2rem) 'Space Grotesk', sans-serif; letter-spacing: -0.03em; background: linear-gradient(90deg, var(--accent), var(--accent2)); -webkit-background-clip: text; background-clip: text; color: transparent; word-break: break-all; }
  @media (max-width: 900px) { .focus { grid-template-columns: 1fr 1fr; } .cards { grid-template-columns: 1fr; } .card.wide { grid-column: auto; } .orb { width: 20rem; height: 20rem; right: -10rem; } }
  @media (max-width: 520px) { .focus { grid-template-columns: 1fr; } }
</style>
