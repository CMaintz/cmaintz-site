---
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/ibm-plex-sans/400.css';
import '@fontsource/ibm-plex-sans/600.css';
import PreviewShell from '../layouts/PreviewShell.astro';
import { homeData, recentRepos } from '../lib/home';
import { formatDate } from '../i18n/ui';
import { github } from '../lib/content';

const d = await homeData();
const repos = recentRepos(5);
const ago = (iso: string) => `${Math.max(0, Math.round((Date.parse(github.syncedAt) - Date.parse(iso)) / 86_400_000))}d`;
---

<PreviewShell style="technical" title="Christoffer Maintz - technical preview">
  <div class="tx">
    <header class="top">
      <a href="/technical" class="mark">~/cmaintz</a>
      <nav><a href="/about">about</a><a href="/projects">projects</a><a href="/blog">blog</a><a href="/contact">contact</a><kbd>⌘K</kbd></nav>
    </header>

    <main>
      <section class="hero">
        <div>
          <p class="prompt">$ cat README.md</p>
          <h1>Christoffer Maintz</h1>
          <p class="role">DX · DevOps · Platform · AI enablement</p>
          <p class="lede">{d.lede}</p>
          <p class="links"><a href="/projects">./projects</a> <a href="/contact">./contact</a> <a href="https://github.com/CMaintz">github ↗</a></p>
        </div>
        <aside class="status" aria-label="Live GitHub status">
          <p class="h"><span class="dot"></span> recent pushes · synced {formatDate(new Date(github.syncedAt), 'en')}</p>
          <table>
            <thead><tr><th>repo</th><th>lang</th><th>push</th></tr></thead>
            <tbody>
              {repos.map((r) => (
                <tr><td><a href={r.url}>{r.name}</a></td><td>{r.language?.name ?? '-'}</td><td>{ago(r.pushedAt)}</td></tr>
              ))}
            </tbody>
          </table>
        </aside>
      </section>

      <section class="block">
        <h2># focus</h2>
        <div class="grid4">
          {d.focus.map((f, i) => <div class="cell"><span class="idx">0{i + 1}</span><h3>{f.title}</h3><p>{f.body}</p></div>)}
        </div>
      </section>

      <section class="block">
        <h2># featured</h2>
        <div class="grid3">
          {d.projects.map((p) => (
            <a class="card" href={`/projects/${p.id}`}>
              <span class="path">{p.category}/{p.id}</span>
              <h3>{p.title}</h3>
              <p>{p.tagline}</p>
              <span class="tags">{p.stack.map((s) => <code>{s}</code>)}</span>
              {p.stars > 0 && <span class="stars">★ {p.stars}</span>}
            </a>
          ))}
        </div>
      </section>

      <section class="block">
        <h2># log</h2>
        <ul class="log">
          {d.posts.map((p) => (
            <li><time>{p.date.toISOString().slice(0, 10)}</time><a href={`/blog/${p.id}`}>{p.title}</a><span>{p.minutes}m</span></li>
          ))}
        </ul>
      </section>

      <section class="cta">
        <p><span class="prompt">$</span> ./hire --role=devops --or=freelance</p>
        <p class="dim">{d.ctaBody}</p>
        <a href="/contact" class="btn">open contact form →</a>
      </section>
    </main>
  </div>
</PreviewShell>

<style>
  .tx {
    --bg: #f6f8fa; --panel: #ffffff; --fg: #1f2328; --dim: #59636e; --line: #d1d9e0; --accent: #1a7f37;
    background: var(--bg); color: var(--fg);
    font: 400 15px/1.6 'IBM Plex Sans', system-ui, sans-serif;
    min-height: 100vh;
    padding: 0 clamp(1rem, 4vw, 2.5rem) 5rem;
  }
  @media (prefers-color-scheme: dark) {
    .tx { --bg: #0d1117; --panel: #161b22; --fg: #c9d1d9; --dim: #8b949e; --line: #30363d; --accent: #3fb950; }
  }
  .tx a { color: inherit; }
  .top, main { max-width: 70rem; margin: 0 auto; }
  .top { display: flex; justify-content: space-between; align-items: center; padding-block: 1.2rem; border-bottom: 1px solid var(--line); font-family: 'JetBrains Mono', monospace; font-size: 0.85rem; flex-wrap: wrap; gap: 1rem; }
  .mark { font-weight: 600; text-decoration: none; }
  .top nav { display: flex; gap: 1.2rem; align-items: center; }
  .top nav a { text-decoration: none; color: var(--dim); }
  .top nav a:hover { color: var(--accent); }
  kbd { border: 1px solid var(--line); padding: 0 0.35rem; font-size: 0.75rem; color: var(--dim); }
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: 3rem; padding-block: 4rem 3rem; align-items: start; }
  .prompt { font: 0.85rem 'JetBrains Mono', monospace; color: var(--accent); margin: 0 0 0.8rem; }
  h1 { font: 600 clamp(2rem, 4.5vw, 3rem)/1.1 'JetBrains Mono', monospace; letter-spacing: -0.03em; margin: 0; }
  .role { font: 0.9rem 'JetBrains Mono', monospace; color: var(--dim); margin: 0.6rem 0 1.4rem; }
  .lede { font-size: 1.05rem; margin: 0 0 1.4rem; max-width: 38rem; }
  .links { display: flex; gap: 1.2rem; font: 0.85rem 'JetBrains Mono', monospace; }
  .links a { color: var(--accent); }
  .status { background: var(--panel); border: 1px solid var(--line); font: 0.78rem 'JetBrains Mono', monospace; }
  .status .h { margin: 0; padding: 0.6rem 0.8rem; border-bottom: 1px solid var(--line); color: var(--dim); display: flex; gap: 0.5rem; align-items: center; }
  .dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 25%, transparent); }
  table { width: 100%; border-collapse: collapse; }
  th, td { text-align: left; padding: 0.45rem 0.8rem; border-bottom: 1px solid var(--line); }
  th { color: var(--dim); font-weight: 400; }
  td a { text-decoration: none; }
  td a:hover { color: var(--accent); }
  .block { margin-top: 3rem; }
  h2 { font: 600 0.95rem 'JetBrains Mono', monospace; color: var(--dim); margin: 0 0 1rem; }
  .grid4 { display: grid; grid-template-columns: repeat(4, 1fr); border: 1px solid var(--line); background: var(--panel); }
  .cell { padding: 1.2rem; border-right: 1px solid var(--line); }
  .cell:last-child { border-right: 0; }
  .idx { font: 0.75rem 'JetBrains Mono', monospace; color: var(--accent); }
  .cell h3 { font-size: 1rem; margin: 0.3rem 0; }
  .cell p { margin: 0; color: var(--dim); font-size: 0.88rem; }
  .grid3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1rem; }
  .card { display: grid; gap: 0.5rem; align-content: start; padding: 1.1rem; background: var(--panel); border: 1px solid var(--line); text-decoration: none; position: relative; transition: border-color 120ms; }
  .card:hover { border-color: var(--accent); }
  .path { font: 0.72rem 'JetBrains Mono', monospace; color: var(--dim); }
  .card h3 { font: 600 1.05rem 'JetBrains Mono', monospace; margin: 0; }
  .card p { margin: 0; color: var(--dim); font-size: 0.9rem; }
  .tags { display: flex; flex-wrap: wrap; gap: 0.3rem; }
  code { font: 0.7rem 'JetBrains Mono', monospace; background: var(--bg); border: 1px solid var(--line); padding: 0.05rem 0.35rem; }
  .stars { position: absolute; top: 1rem; right: 1rem; font: 0.75rem 'JetBrains Mono', monospace; color: var(--dim); }
  .log { list-style: none; padding: 0; margin: 0; font: 0.88rem 'JetBrains Mono', monospace; border-top: 1px solid var(--line); }
  .log li { display: grid; grid-template-columns: 7rem 1fr auto; gap: 1rem; padding: 0.6rem 0; border-bottom: 1px solid var(--line); }
  .log time, .log span { color: var(--dim); }
  .log a { text-decoration: none; }
  .log a:hover { color: var(--accent); }
  .cta { margin-top: 3.5rem; padding: 1.5rem; border: 1px dashed var(--line); font-family: 'JetBrains Mono', monospace; }
  .cta p { margin: 0 0 0.5rem; }
  .dim { color: var(--dim); font-family: 'IBM Plex Sans', sans-serif; }
  .btn { display: inline-block; margin-top: 0.6rem; padding: 0.5rem 0.9rem; background: var(--accent); color: #fff !important; text-decoration: none; font-size: 0.85rem; }
  @media (prefers-color-scheme: dark) { .btn { color: #0d1117 !important; } }
  @media (max-width: 900px) { .hero { grid-template-columns: 1fr; } .grid4 { grid-template-columns: 1fr 1fr; } .grid3 { grid-template-columns: 1fr; } }
  @media (max-width: 560px) { .grid4 { grid-template-columns: 1fr; } .cell { border-right: 0; border-bottom: 1px solid var(--line); } .log li { grid-template-columns: 1fr auto; } .log time { display: none; } }
</style>
