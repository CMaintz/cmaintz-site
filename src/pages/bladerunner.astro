---
// Style preview: neon noir (Blade Runner). Rain over a smoggy orange haze,
// flickering neon signage, and an ESPER-style "enhance" frame around the photo.
import '@fontsource/barlow-condensed/300.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/space-mono/400.css';
import PreviewShell from '../layouts/PreviewShell.astro';
import { homeData } from '../lib/home';
import { site } from '../data/site';

const d = await homeData();
---

<PreviewShell style="bladerunner" title="Christoffer Maintz - bladerunner preview">
  <div class="br">
    <canvas class="rain" aria-hidden="true"></canvas>
    <header class="top">
      <a class="sign" href="/bladerunner">CM<span>·</span>DEV</a>
      <nav><a href="/about">About</a><a href="/projects">Work</a><a href="/blog">Blog</a><a href="/contact">Contact</a></nav>
    </header>

    <main>
      <section class="hero">
        <div class="copy">
          <p class="kicker">AARHUS · 2026 · {d.status}</p>
          <h1>Christoffer<br /><span>Maintz</span></h1>
          <p class="lede">{d.lede}</p>
          <p class="ctas"><a class="neon-btn" href="/projects">See the work</a><a class="ghost" href="/contact">Get in touch</a></p>
        </div>
        <figure class="esper">
          <picture>
            <source srcset="/img/christoffer.webp" type="image/webp" />
            <img src="/img/christoffer.jpg" alt="Portrait of Christoffer Maintz" width="640" height="800" />
          </picture>
          <span class="grid" aria-hidden="true"></span>
          <span class="cross" aria-hidden="true"></span>
          <figcaption>ENHANCE 224 TO 176 · TRACK 45 RIGHT · STOP</figcaption>
        </figure>
      </section>

      <section class="block">
        <h2>What I do</h2>
        <div class="focus">
          {d.focus.map((f, i) => <div class="f"><span class="n">0{i + 1}</span><h3>{f.title}</h3><p>{f.body}</p></div>)}
        </div>
      </section>

      <section class="block">
        <h2>Selected work</h2>
        <div class="cards">
          {d.projects.map((p, i) => (
            <a class="card" href={`/projects/${p.id}`}>
              <span class="unit">UNIT {String(i + 1).padStart(2, '0')} · {p.category}</span>
              <h3>{p.title}</h3>
              <p>{p.tagline}</p>
            </a>
          ))}
        </div>
      </section>

      <section class="block">
        <h2>Log</h2>
        <ul class="log">{d.posts.map((p) => <li><a href={`/blog/${p.id}`}><span>{p.title}</span><i>→</i></a></li>)}</ul>
      </section>

      <section class="open">
        <p class="neon">OPEN FOR WORK</p>
        <p class="dim">{d.ctaBody}</p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </section>
    </main>
  </div>
</PreviewShell>

<script>
  // Rain: a few hundred slanted streaks on a canvas. Static under reduced motion.
  type Drop = { x: number; y: number; len: number; speed: number };
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.rain');
  const ctx = canvas?.getContext('2d');
  const drops: Drop[] = [];

  function resize() {
    canvas!.width = innerWidth;
    canvas!.height = innerHeight;
  }

  function spawn(): Drop {
    return { x: Math.random() * innerWidth * 1.2, y: Math.random() * -innerHeight, len: 10 + Math.random() * 18, speed: 7 + Math.random() * 8 };
  }

  function step(drop: Drop) {
    drop.y += drop.speed;
    drop.x -= drop.speed * 0.25;
    if (drop.y > innerHeight) Object.assign(drop, spawn(), { y: -20 });
  }

  function draw() {
    ctx!.clearRect(0, 0, innerWidth, innerHeight);
    ctx!.strokeStyle = 'rgba(160, 220, 255, 0.28)';
    ctx!.lineWidth = 1;
    ctx!.beginPath();
    for (const d of drops) {
      ctx!.moveTo(d.x, d.y);
      ctx!.lineTo(d.x - d.len * 0.25, d.y + d.len);
    }
    ctx!.stroke();
  }

  function frame() {
    drops.forEach(step);
    draw();
    requestAnimationFrame(frame);
  }

  if (canvas && ctx) {
    resize();
    addEventListener('resize', resize);
    for (let i = 0; i < 260; i++) drops.push({ ...spawn(), y: Math.random() * innerHeight });
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) draw();
    else requestAnimationFrame(frame);
  }
</script>

<style>
  .br {
    --pink: #ff2a6d; --cyan: #05d9e8; --orange: #ff8b3d; --pale: #d1f7ff; --dim: #8aa4b8; --line: rgb(5 217 232 / 0.25);
    min-height: 100vh; position: relative; overflow: hidden; color: var(--pale);
    background:
      radial-gradient(ellipse 80% 50% at 70% 100%, rgb(255 139 61 / 0.35), transparent 70%),
      radial-gradient(ellipse 60% 40% at 10% 0%, rgb(255 42 109 / 0.18), transparent 70%),
      linear-gradient(#02030c, #0a0b1f 60%, #1a0f1c);
    font: 400 16px/1.65 'Space Mono', ui-monospace, monospace;
    padding: 0 clamp(1rem, 4vw, 3rem) 6rem;
  }
  .rain { position: fixed; inset: 0; pointer-events: none; z-index: 0; }
  .top, main { position: relative; z-index: 1; max-width: 74rem; margin: 0 auto; }
  .br a { color: inherit; text-decoration: none; }
  .top { display: flex; justify-content: space-between; align-items: center; padding-block: 1.5rem; flex-wrap: wrap; gap: 1rem; }
  .sign { font: 600 1.6rem 'Barlow Condensed', sans-serif; letter-spacing: 0.15em; color: var(--pink); text-shadow: 0 0 8px var(--pink), 0 0 24px var(--pink); }
  .sign span { color: var(--cyan); text-shadow: 0 0 8px var(--cyan); }
  .top nav { display: flex; gap: 1.5rem; font-size: 0.85rem; text-transform: uppercase; letter-spacing: 0.15em; }
  .top nav a:hover { color: var(--cyan); text-shadow: 0 0 8px var(--cyan); }
  .hero { display: grid; grid-template-columns: 1.3fr 1fr; gap: clamp(2rem, 5vw, 5rem); align-items: center; padding-block: clamp(3rem, 8vw, 7rem) 3rem; }
  .kicker { font-size: 0.75rem; letter-spacing: 0.3em; color: var(--orange); text-transform: uppercase; margin: 0 0 1rem; }
  h1 { font: 300 clamp(3.2rem, 9vw, 7.5rem)/0.9 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.04em; margin: 0 0 1.5rem; }
  h1 span { font-weight: 600; color: var(--cyan); text-shadow: 0 0 10px var(--cyan), 0 0 40px rgb(5 217 232 / 0.6); }
  .lede { color: var(--dim); max-width: 34rem; margin: 0; font-size: 0.95rem; }
  .ctas { display: flex; gap: 1rem; margin-top: 2rem; flex-wrap: wrap; }
  .neon-btn { padding: 0.8rem 1.4rem; border: 2px solid var(--pink); color: var(--pink); text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.8rem; box-shadow: 0 0 12px rgb(255 42 109 / 0.5), inset 0 0 12px rgb(255 42 109 / 0.3); text-shadow: 0 0 6px var(--pink); }
  .neon-btn:hover { background: var(--pink); color: #0a0b1f; text-shadow: none; }
  .ghost { padding: 0.8rem 1.4rem; border: 1px solid var(--line); text-transform: uppercase; letter-spacing: 0.15em; font-size: 0.8rem; }
  .esper { position: relative; margin: 0; border: 1px solid var(--line); background: #000; aspect-ratio: 4 / 5; overflow: hidden; }
  .esper img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(0.5) contrast(1.15) brightness(0.7); }
  .esper::before { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; mix-blend-mode: color; background: linear-gradient(160deg, #0a4a5c 0%, #1b1f3a 55%, #7a3a1a 100%); }
  .esper .grid, .esper .cross, .esper figcaption { z-index: 2; }
  .grid { position: absolute; inset: 0; background: linear-gradient(var(--line) 1px, transparent 1px) 0 0 / 100% 12.5%, linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0 / 12.5% 100%; mix-blend-mode: screen; }
  .cross { position: absolute; left: 35%; top: 30%; width: 30%; height: 28%; border: 1px solid var(--orange); box-shadow: 0 0 10px rgb(255 139 61 / 0.6); }
  .cross::before, .cross::after { content: ''; position: absolute; background: var(--orange); }
  .cross::before { left: 50%; top: -30%; bottom: -30%; width: 1px; }
  .cross::after { top: 50%; left: -30%; right: -30%; height: 1px; }
  figcaption { position: absolute; left: 0; right: 0; bottom: 0; padding: 0.4rem 0.7rem; font-size: 0.65rem; letter-spacing: 0.15em; color: var(--orange); background: rgb(0 0 0 / 0.6); }
  .block { margin-top: 5rem; }
  h2 { font: 600 clamp(1.8rem, 4vw, 2.8rem) 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.08em; margin: 0 0 1.5rem; color: var(--pale); }
  .focus { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); gap: 1rem; }
  .f { padding: 1.2rem; border-top: 2px solid var(--cyan); background: rgb(5 217 232 / 0.04); }
  .n { color: var(--orange); font-size: 0.75rem; }
  .f h3 { font: 600 1.35rem 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.05em; margin: 0.3rem 0; }
  .f p { color: var(--dim); font-size: 0.85rem; margin: 0; }
  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr)); gap: 1rem; }
  .card { display: grid; gap: 0.4rem; padding: 1.3rem; border: 1px solid var(--line); background: linear-gradient(135deg, rgb(255 42 109 / 0.06), rgb(5 217 232 / 0.04)); transition: border-color 200ms, box-shadow 200ms; }
  .card:hover { border-color: var(--pink); box-shadow: 0 0 20px rgb(255 42 109 / 0.35); }
  .unit { font-size: 0.7rem; letter-spacing: 0.2em; color: var(--orange); text-transform: uppercase; }
  .card h3 { font: 600 1.7rem 'Barlow Condensed', sans-serif; margin: 0; text-transform: uppercase; }
  .card p { margin: 0; color: var(--dim); font-size: 0.85rem; }
  .log { list-style: none; padding: 0; margin: 0; }
  .log a { display: flex; justify-content: space-between; padding: 1rem 0; border-bottom: 1px solid var(--line); font: 300 1.5rem 'Barlow Condensed', sans-serif; text-transform: uppercase; letter-spacing: 0.05em; }
  .log i { font-style: normal; color: var(--pink); text-shadow: 0 0 8px var(--pink); }
  .log a:hover span { color: var(--cyan); }
  .open { margin-top: 6rem; text-align: center; }
  .neon { font: 600 clamp(2.4rem, 7vw, 5rem) 'Barlow Condensed', sans-serif; letter-spacing: 0.12em; color: var(--pink); text-shadow: 0 0 10px var(--pink), 0 0 40px var(--pink), 0 0 80px rgb(255 42 109 / 0.5); margin: 0 0 1rem; }
  .dim { color: var(--dim); }
  .open a { color: var(--cyan); text-shadow: 0 0 8px var(--cyan); font-size: 1.1rem; }
  @media (prefers-reduced-motion: no-preference) {
    .neon, .sign { animation: flicker 5s steps(1) infinite; }
    .cross { animation: track 7s ease-in-out infinite alternate; }
  }
  @keyframes flicker { 0%, 88%, 92%, 100% { opacity: 1; } 89% { opacity: 0.35; } 91% { opacity: 0.7; } }
  @keyframes track { 0% { left: 35%; top: 30%; width: 30%; height: 28%; } 50% { left: 28%; top: 22%; width: 44%; height: 40%; } 100% { left: 40%; top: 34%; width: 22%; height: 18%; } }
  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } .esper { max-width: 22rem; } }
</style>
