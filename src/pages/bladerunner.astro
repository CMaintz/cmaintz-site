---
// Style preview inspired by the on-screen tech of Blade Runner (1982): an ESPER
// photo-analysis screen stepping through enhancements, a Voight-Kampff-style
// response panel, and amber spinner-dashboard LED readouts.
import '@fontsource/share-tech-mono/400.css';
import '@fontsource/vt323/400.css';
import PreviewShell from '../layouts/PreviewShell.astro';
import { homeData } from '../lib/home';
import { site } from '../data/site';

const d = await homeData();
const steps = ['ENHANCE 224 176', 'TRACK 45 RIGHT', 'STOP', 'ENHANCE 34 36', 'PULL BACK', 'CENTER AND STOP'];
---

<PreviewShell style="bladerunner" title="Christoffer Maintz - bladerunner preview">
  <div class="br">
    <header class="dash">
      <span class="led">CM-2019</span><span class="led dim">LAPD SPINNER · UNIT 07</span><span class="led">ALT 0412</span><span class="led red">● LINK</span>
    </header>

    <main class="grid">
      <section class="esper" aria-label="ESPER photo analysis">
        <div class="esper__screen">
          <div class="esper__photo">
            <img src="/img/christoffer.jpg" alt="Portrait of Christoffer Maintz" width="640" height="800" />
          </div>
          <span class="esper__grid" aria-hidden="true"></span>
          <span class="esper__cross" aria-hidden="true"></span>
          <ol class="esper__steps" aria-hidden="true">{steps.map((s, i) => <li style={`--i:${i}`}>{s}</li>)}</ol>
        </div>
        <p class="esper__label">ESPER · IMAGE 4.18 · SUBJECT: CHRISTOFFER MAINTZ</p>
      </section>

      <section class="vk" aria-label="Response panel">
        <p class="vk__title">V-K RESPONSE MONITOR</p>
        <h1>Christoffer Maintz</h1>
        <p class="vk__sub">DEVELOPER · AARHUS · {d.status.toUpperCase()}</p>
        <p class="vk__lede">{d.lede}</p>
        <div class="vk__meters">
          {d.focus.map((f, i) => (
            <div class="meter"><span class="meter__name">{f.title}</span><span class="meter__bar" style={`--v:${[0.82, 0.9, 0.7, 0.95][i]};--d:${1.6 + i * 0.4}s`}></span><span class="meter__num">0.{[82, 90, 70, 95][i]}</span></div>
          ))}
        </div>
        <p class="vk__verdict">RESULT: <span>HUMAN</span> · EMPATHIC RESPONSE WITHIN RANGE</p>
      </section>

      <section class="db wide" aria-label="Projects">
        <p class="db__title">POLICE DATABASE // CASE FILES</p>
        <ul>
          {d.projects.map((p, i) => (
            <li><span class="led">{String(i + 1).padStart(2, '0')}</span><a href={`/projects/${p.id}`}>{p.title}</a><span class="db__desc">{p.tagline}</span><span class="led amber">{p.category.toUpperCase()}</span></li>
          ))}
        </ul>
      </section>

      <section class="db" aria-label="Log">
        <p class="db__title">INCIDENT LOG</p>
        <ul class="log">{d.posts.map((p) => <li><span class="led dim">{p.date.toISOString().slice(0, 10)}</span><a href={`/blog/${p.id}`}>{p.title}</a></li>)}</ul>
      </section>

      <section class="db contact" aria-label="Contact">
        <p class="db__title">DISPATCH</p>
        <p class="led big">OPEN FOR WORK</p>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </section>
    </main>
  </div>
</PreviewShell>

<style>
  .br {
    --amber: #ffb347; --red: #ff4d3a; --ice: #9fd6ff; --panel: #0b0d10; --line: #2a2f36;
    min-height: 100vh; padding: 1.2rem clamp(1rem, 3vw, 2.5rem) 4rem; color: #cfd8e0;
    background: radial-gradient(ellipse at 50% -20%, #1b2530 0%, #07090c 60%), #07090c;
    font: 400 14px/1.55 'Share Tech Mono', ui-monospace, monospace;
  }
  .br a { color: inherit; text-decoration: none; }
  .led { font: 400 1.15rem 'VT323', monospace; color: var(--amber); text-shadow: 0 0 6px rgb(255 179 71 / 0.7); letter-spacing: 0.08em; }
  .led.dim { opacity: 0.6; } .led.red { color: var(--red); text-shadow: 0 0 6px var(--red); }
  .dash { max-width: 80rem; margin: 0 auto 1.2rem; display: flex; justify-content: space-between; flex-wrap: wrap; gap: 1rem; padding: 0.5rem 1rem; background: #050607; border: 1px solid var(--line); border-radius: 4px; box-shadow: inset 0 0 20px #000; }
  .grid { max-width: 80rem; margin: 0 auto; display: grid; grid-template-columns: 1fr 1.2fr; gap: 1.2rem; }
  .wide { grid-column: 1 / -1; }
  .esper { background: #1a1d21; border: 1px solid var(--line); padding: 1rem; border-radius: 6px; }
  .esper__screen { position: relative; aspect-ratio: 4 / 5; overflow: hidden; background: #000; border-radius: 10px / 8px; box-shadow: inset 0 0 50px #000; }
  .esper__photo { position: absolute; inset: 0; }
  .esper__photo img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1) contrast(1.35) brightness(0.8); }
  .esper__screen::before { content: ''; position: absolute; inset: 0; z-index: 1; background: #2b6fd0; mix-blend-mode: multiply; }
  .esper__screen::after { content: ''; position: absolute; inset: 0; z-index: 3; pointer-events: none; background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.4) 0 1px, transparent 1px 3px); }
  .esper__grid { position: absolute; inset: 0; z-index: 2; background: linear-gradient(rgb(159 214 255 / 0.25) 1px, transparent 1px) 0 0 / 100% 10%, linear-gradient(90deg, rgb(159 214 255 / 0.25) 1px, transparent 1px) 0 0 / 10% 100%; }
  .esper__cross { position: absolute; z-index: 2; left: 50%; top: 40%; width: 34%; aspect-ratio: 1; transform: translate(-50%, -50%); border: 1px solid var(--ice); }
  .esper__steps { position: absolute; z-index: 4; left: 0.8rem; bottom: 0.6rem; list-style: none; margin: 0; padding: 0; font: 400 1.3rem 'VT323', monospace; color: var(--ice); text-shadow: 0 0 6px var(--ice); }
  .esper__steps li:not(:last-child) { display: none; }
  .esper__label { margin: 0.6rem 0 0; font-size: 0.7rem; letter-spacing: 0.2em; color: #8a96a3; }
  .vk { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 1.4rem; box-shadow: inset 0 0 30px #000; }
  .vk__title, .db__title { margin: 0 0 1rem; font-size: 0.7rem; letter-spacing: 0.3em; color: #8a96a3; }
  h1 { font: 400 clamp(2.4rem, 5vw, 3.8rem)/1 'VT323', monospace; margin: 0 0 0.4rem; color: #eef4f8; letter-spacing: 0.04em; }
  .vk__sub { margin: 0 0 1rem; color: var(--amber); letter-spacing: 0.15em; font-size: 0.75rem; }
  .vk__lede { margin: 0 0 1.4rem; color: #aab6c2; }
  .vk__meters { display: grid; gap: 0.7rem; }
  .meter { display: grid; grid-template-columns: 11rem 1fr 3rem; gap: 0.8rem; align-items: center; font-size: 0.78rem; }
  .meter__bar { height: 0.7rem; background: repeating-linear-gradient(90deg, var(--amber) 0 6px, transparent 6px 8px); clip-path: inset(0 calc((1 - var(--v)) * 100%) 0 0); opacity: 0.9; box-shadow: 0 0 8px rgb(255 179 71 / 0.4); }
  .meter__num { font: 400 1.2rem 'VT323', monospace; color: var(--amber); text-align: right; }
  .vk__verdict { margin: 1.4rem 0 0; font-size: 0.75rem; letter-spacing: 0.15em; color: #8a96a3; }
  .vk__verdict span { color: #7dffb2; text-shadow: 0 0 6px #7dffb2; }
  .db { background: var(--panel); border: 1px solid var(--line); border-radius: 6px; padding: 1.2rem 1.4rem; }
  .db ul { list-style: none; margin: 0; padding: 0; }
  .db li { display: grid; grid-template-columns: 2.4rem 11rem 1fr auto; gap: 1rem; align-items: baseline; padding: 0.45rem 0; border-bottom: 1px dashed var(--line); }
  .db li a { color: #eef4f8; }
  .db li a:hover, .contact a:hover { color: var(--amber); }
  .db__desc { color: #8a96a3; font-size: 0.8rem; }
  .log li { grid-template-columns: 7rem 1fr; }
  .contact .big { font-size: 2rem; margin: 0.3rem 0 0.8rem; }
  .contact a { color: var(--ice); }
  @media (prefers-reduced-motion: no-preference) {
    .esper__photo { animation: enhance 12s steps(1) infinite; }
    .esper__cross { animation: seek 12s steps(1) infinite; }
    .esper__steps li { display: block !important; position: absolute; bottom: 0; white-space: nowrap; opacity: 0; animation: step 12s steps(1) infinite; animation-delay: calc(var(--i) * 2s); }
    .meter__bar { animation: needle var(--d) ease-in-out infinite alternate; }
    .contact .big { animation: blink 1.4s steps(2) infinite; }
  }
  @keyframes enhance {
    0% { transform: scale(1) translate(0, 0); } 17% { transform: scale(1.5) translate(-6%, 4%); } 33% { transform: scale(1.5) translate(-12%, 4%); }
    50% { transform: scale(2.3) translate(-8%, 8%); } 67% { transform: scale(1.3) translate(0, 2%); } 83% { transform: scale(1.8) translate(0, 6%); }
  }
  @keyframes seek { 0% { left: 50%; top: 40%; } 17% { left: 44%; top: 44%; } 33% { left: 56%; top: 40%; } 50% { left: 50%; top: 36%; } 67% { left: 50%; top: 50%; } 83% { left: 50%; top: 42%; } }
  @keyframes step { 0%, 16.6% { opacity: 1; } 16.7%, 100% { opacity: 0; } }
  @keyframes needle { to { clip-path: inset(0 calc((1 - var(--v) + 0.18) * 100%) 0 0); } }
  @keyframes blink { 50% { opacity: 0.3; } }
  @media (max-width: 900px) { .grid { grid-template-columns: 1fr; } .esper__screen { max-width: 26rem; } .db li { grid-template-columns: 2.4rem 1fr; } .db__desc, .db li .amber { display: none; } .meter { grid-template-columns: 1fr; gap: 0.2rem; } }
</style>
