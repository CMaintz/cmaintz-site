---
// Style preview inspired by the on-screen tech of Alien (1979): a bank of
// Nostromo bridge monitors with vector-wireframe readouts in cyan, yellow, red
// and white. The green MU/TH/UR terminal is just one of the screens.
import '@fontsource/share-tech-mono/400.css';
import '@fontsource/vt323/400.css';
import PreviewShell from '../layouts/PreviewShell.astro';
import { homeData } from '../lib/home';
import { site } from '../data/site';

const d = await homeData();
const terrain = Array.from({ length: 9 }, (_, row) => {
  const y = 60 + row * row * 3.2;
  const pts = Array.from({ length: 21 }, (_, i) => `${i * 20},${(y - Math.sin(i * 0.9 + row) * (4 + row * 1.5)).toFixed(1)}`);
  return pts.join(' ');
});
const verticals = Array.from({ length: 21 }, (_, i) => i * 20);
---

<PreviewShell style="alien" title="Christoffer Maintz - alien preview">
  <div class="bridge">
    <header class="plate"><span>MSV-CMAINTZ</span><span>COMMERCIAL DEVELOPMENT VESSEL</span><span class="red">● REC</span></header>

    <div class="bank">
      <section class="crt wide cyan" aria-label="Approach">
        <p class="label">APPROACH // TARGET ACQUIRED</p>
        <svg viewBox="0 0 400 300" class="terrain" aria-hidden="true">
          {terrain.map((pts) => <polyline points={pts} />)}
          {verticals.map((x) => <line x1={200 + (x - 200) * 0.35} y1="55" x2={x} y2="300" />)}
          <rect class="target" x="170" y="120" width="60" height="40" />
        </svg>
        <h1>CHRISTOFFER MAINTZ</h1>
        <p class="readout">DEVELOPER · DX · DEVOPS · PLATFORM · AI<br />STATION: AARHUS · STATUS: {d.status.toUpperCase()}</p>
      </section>

      <section class="crt mother" aria-label="Mother">
        <p class="label">MU/TH/UR 6000</p>
        <p>INTERFACE 2037 READY FOR INQUIRY</p>
        <p class="q">&gt; WHAT IS SPECIAL ORDER 937?</p>
        <p>BUILD THE MACHINERY THAT MAKES SOFTWARE TEAMS FASTER AND SAFER.</p>
        <p class="q">&gt; CREW EXPENDABLE?</p>
        <p>NEGATIVE. HUMANS REVIEW WHAT THE SYSTEM IS UNSURE ABOUT.<span class="blink">█</span></p>
      </section>

      <section class="crt yellow" aria-label="Focus orbits">
        <p class="label">ORBITAL SCHEMATIC // FOCUS</p>
        <svg viewBox="0 0 200 200" class="orbits" aria-hidden="true">
          <circle cx="100" cy="100" r="12" class="core" />
          {[34, 52, 70, 88].map((r, i) => <g class="orbit" style={`--d:${14 + i * 6}s`}><circle cx="100" cy="100" r={r} /><rect x={100 + r - 3} y="97" width="6" height="6" /></g>)}
        </svg>
        <ul class="legend">{d.focus.map((f, i) => <li><span>0{i + 1}</span>{f.title.toUpperCase()}</li>)}</ul>
      </section>

      <section class="crt red" aria-label="Readouts">
        <p class="label">SYSTEMS // OUTPUT</p>
        <dl class="bars">
          <dt>PRODUCTS ENRICHED</dt><dd><i style="--v:0.95"></i><b>3000+</b></dd>
          <dt>HOURS SAVED</dt><dd><i style="--v:0.8"></i><b>1000+</b></dd>
          <dt>OPEN SOURCE TOOLS</dt><dd><i style="--v:0.45"></i><b>5</b></dd>
          <dt>LANGUAGES</dt><dd><i style="--v:0.6"></i><b>9</b></dd>
        </dl>
      </section>

      <section class="crt cyan" aria-label="Log">
        <p class="label">FLIGHT LOG</p>
        <ul class="log">{d.posts.map((p) => <li><span>{p.date.toISOString().slice(0, 10)}</span><a href={`/blog/${p.id}`}>{p.title.toUpperCase()}</a></li>)}</ul>
      </section>

      <section class="crt wide white" aria-label="Cargo manifest">
        <p class="label">CARGO MANIFEST // SHIPPED</p>
        <table>
          <thead><tr><th>ID</th><th>DESIGNATION</th><th>CLASS</th><th>PAYLOAD</th></tr></thead>
          <tbody>
            {d.projects.map((p, i) => (
              <tr><td>{String(i + 1).padStart(3, '0')}</td><td><a href={`/projects/${p.id}`}>{p.title.toUpperCase()}</a></td><td>{p.category.toUpperCase()}</td><td class="dim">{p.tagline}</td></tr>
            ))}
          </tbody>
        </table>
      </section>

      <section class="crt red alert" aria-label="Contact">
        <p class="label">PRIORITY ONE</p>
        <p class="big">ESTABLISH CONTACT</p>
        <a href={`mailto:${site.email}`}>{site.email.toUpperCase()}</a>
      </section>
    </div>
  </div>
</PreviewShell>

<style>
  .bridge {
    --cyan: #3ff0ff; --yellow: #ffd23f; --red: #ff4b3e; --white: #e9f1f2; --green: #74ff8f; --bezel: #26282b;
    min-height: 100vh; padding: 1.5rem clamp(1rem, 3vw, 2.5rem) 4rem;
    background: repeating-linear-gradient(90deg, #17181a 0 2px, #1c1d20 2px 6px), #17181a;
    font: 400 15px/1.5 'Share Tech Mono', ui-monospace, monospace; color: var(--white);
  }
  .plate { max-width: 78rem; margin: 0 auto 1.2rem; display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap; padding: 0.5rem 1rem; background: #c9c3b4; color: #1a1a1a; font-size: 0.75rem; letter-spacing: 0.25em; border: 2px solid #8d887a; }
  .plate .red { color: #b3160b; }
  .bank { max-width: 78rem; margin: 0 auto; display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.2rem; }
  .crt {
    position: relative; overflow: hidden; padding: 1.1rem 1.2rem; min-height: 14rem;
    background: radial-gradient(ellipse at center, #06100f 0%, #010303 80%);
    border: 14px solid var(--bezel); border-radius: 26px / 20px;
    box-shadow: inset 0 0 40px rgb(0 0 0 / 0.9), 0 0 0 2px #0c0c0d, 0 6px 0 #0c0c0d;
    color: var(--c); text-shadow: 0 0 6px var(--c);
  }
  .crt::after { content: ''; position: absolute; inset: 0; pointer-events: none; background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.35) 0 1px, transparent 1px 3px); }
  .wide { grid-column: span 2; }
  .cyan { --c: var(--cyan); } .yellow { --c: var(--yellow); } .red { --c: var(--red); } .white { --c: var(--white); } .mother { --c: var(--green); }
  .label { margin: 0 0 0.8rem; font-size: 0.7rem; letter-spacing: 0.3em; opacity: 0.75; }
  .crt a { color: inherit; text-decoration: none; }
  .crt a:hover { background: var(--c); color: #000; text-shadow: none; }
  .terrain { position: absolute; inset: 2.2rem 0 0; width: 100%; height: calc(100% - 2.2rem); opacity: 0.55; }
  .terrain polyline, .terrain line { fill: none; stroke: var(--cyan); stroke-width: 0.8; }
  .target { fill: none; stroke: var(--yellow); stroke-width: 1.5; }
  h1 { position: relative; font: 400 clamp(2.4rem, 6vw, 4.6rem)/1 'VT323', monospace; letter-spacing: 0.08em; margin: 6rem 0 0.6rem; color: var(--white); text-shadow: 0 0 10px var(--cyan); }
  .readout { position: relative; font-size: 0.8rem; letter-spacing: 0.15em; margin: 0; }
  .mother { font-family: 'VT323', monospace; font-size: 1.25rem; line-height: 1.25; }
  .mother p { margin: 0 0 0.5rem; }
  .q { opacity: 0.7; }
  .orbits { width: 70%; display: block; margin: 0 auto; }
  .orbits circle { fill: none; stroke: var(--yellow); stroke-width: 0.8; opacity: 0.7; }
  .orbits .core { fill: var(--yellow); opacity: 1; }
  .orbits rect { fill: var(--yellow); }
  .orbit { transform-origin: 100px 100px; }
  .legend { list-style: none; padding: 0; margin: 0.8rem 0 0; font-size: 0.75rem; letter-spacing: 0.1em; }
  .legend span { margin-right: 0.6rem; opacity: 0.6; }
  .bars { display: grid; grid-template-columns: 1fr; gap: 0.2rem; margin: 0; font-size: 0.72rem; letter-spacing: 0.15em; }
  .bars dt { opacity: 0.75; margin-top: 0.5rem; }
  .bars dd { margin: 0; display: flex; align-items: center; gap: 0.6rem; }
  .bars i { display: block; height: 0.8rem; flex: 1; background: linear-gradient(90deg, var(--red) calc(var(--v) * 100%), transparent 0); outline: 1px solid var(--red); transform-origin: left; }
  .bars b { font: 400 1.3rem 'VT323', monospace; min-width: 3.5rem; text-align: right; }
  table { width: 100%; border-collapse: collapse; font-size: 0.8rem; position: relative; }
  th { text-align: left; font-weight: 400; opacity: 0.6; letter-spacing: 0.2em; font-size: 0.68rem; padding: 0.3rem 0.5rem; border-bottom: 1px solid var(--c); }
  td { padding: 0.35rem 0.5rem; vertical-align: top; }
  td.dim { opacity: 0.65; }
  .log { list-style: none; padding: 0; margin: 0; font-size: 0.8rem; }
  .log li { display: grid; gap: 0.1rem; margin-bottom: 0.8rem; }
  .log span { opacity: 0.6; font-size: 0.7rem; }
  .big { font: 400 2.2rem/1 'VT323', monospace; margin: 0.5rem 0 1rem; }
  @media (prefers-reduced-motion: no-preference) {
    .terrain { animation: fly 2.5s linear infinite; }
    .target { animation: lock 1.2s steps(2) infinite; }
    .orbit { animation: spin var(--d) linear infinite; }
    .bars i { animation: pulse 3s ease-in-out infinite alternate; }
    .blink, .alert .big { animation: lock 1s steps(2) infinite; }
    .crt { animation: roll 7s steps(1) infinite; }
  }
  @keyframes fly { from { transform: translateY(0); } to { transform: translateY(12px); } }
  @keyframes lock { 50% { opacity: 0.2; } }
  @keyframes spin { to { transform: rotate(360deg); } }
  @keyframes pulse { to { transform: scaleX(0.92); } }
  @keyframes roll { 0%, 97%, 100% { filter: none; } 98% { filter: brightness(1.4) contrast(1.2); } }
  @media (max-width: 980px) { .bank { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 680px) { .bank { grid-template-columns: 1fr; } .wide { grid-column: auto; } td:nth-child(4), th:nth-child(4), td:nth-child(3), th:nth-child(3) { display: none; } }
</style>
