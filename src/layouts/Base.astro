---
import '@fontsource/hanken-grotesk/400.css';
import '@fontsource/hanken-grotesk/600.css';
import '@fontsource/hanken-grotesk/700.css';
import '@fontsource/hanken-grotesk/800.css';
import '@fontsource/jetbrains-mono/400.css';
import '@fontsource/jetbrains-mono/500.css';
import '@fontsource/jetbrains-mono/600.css';
import '@fontsource/silkscreen/400.css';
import '../styles/global.css';
import '../styles/prose.css';
import { PUBLIC_ASSISTANT, PUBLIC_CF_BEACON_TOKEN, PUBLIC_UMAMI_WEBSITE_ID } from 'astro:env/client';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import PixelField from '../components/PixelField.astro';
import CommandPalette from '../components/CommandPalette.astro';
import DoomLauncher from '../components/DoomLauncher.astro';
import Assistant from '../components/Assistant.astro';
import { site } from '../data/site';
import { DISPLAY_EFFECTS } from '../data/display-effects';
import { type Lang, localize, unlocalize, useT } from '../i18n/ui';
import { businessLd, clipDescription, graph, personLd, websiteLd } from '../lib/seo';

interface Props {
  title?: string;
  description?: string;
  lang: Lang;
  /**
   * Unlocalized path of this page in each language, for pages whose path differs
   * between languages (a translated post). False for a page in one language only.
   */
  alternates?: boolean | Record<Lang, string>;
  ogImage?: string;
  type?: 'website' | 'article';
  publishedTime?: Date;
  jsonLd?: Record<string, unknown>;
  /** Unlocalized path the language switch targets; defaults to the current page. */
  langSwitchPath?: string;
  /** Keep the page out of search results while still following its links. */
  noindex?: boolean;
}

const { title, description = site.description[Astro.props.lang], lang, alternates = true, ogImage = '/og.png', type = 'website', publishedTime, jsonLd, langSwitchPath, noindex = false } = Astro.props;
const t = useT(lang);
const fullTitle = title ? `${title} · ${site.name}` : `${site.name} - ${site.role[lang]}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const basePath = unlocalize(Astro.url.pathname);
const alt = alternates === true ? { en: basePath, da: basePath } : alternates || undefined;
const og = new URL(ogImage, Astro.site);
const ld = jsonLd ?? graph(personLd(Astro.site), businessLd(Astro.site, lang), websiteLd(Astro.site));
const metaDescription = clipDescription(description);
---

<!doctype html>
<html lang={lang} data-theme="dark" data-scan="on" data-glow="on" data-motion="on">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={site.name} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    <link rel="canonical" href={canonical} />
    {
      alt && (
        <>
          <link rel="alternate" hreflang="en" href={new URL(localize(alt.en, 'en'), Astro.site)} />
          <link rel="alternate" hreflang="da" href={new URL(localize(alt.da, 'da'), Astro.site)} />
          <link rel="alternate" hreflang="x-default" href={new URL(localize(alt.en, 'en'), Astro.site)} />
        </>
      )
    }
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="alternate" type="application/rss+xml" title={`${site.name} - blog`} href="/rss.xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#121212" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={og} />
    <meta property="og:locale" content={lang === 'da' ? 'da_DK' : 'en_GB'} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(ld)} />
    <script is:inline define:vars={{ effects: DISPLAY_EFFECTS }}>
      // Apply stored theme and display-effect prefs before first paint (no flash).
      (() => {
        const d = document.documentElement;
        d.classList.add('js');
        try {
          const prefersLight = matchMedia('(prefers-color-scheme: light)').matches;
          const theme = localStorage.getItem('theme') ?? (prefersLight ? 'light' : 'dark');
          d.dataset.theme = theme;
          // 'crt' is the old single switch for scanlines and glow together.
          const legacy = localStorage.getItem('crt');
          const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)').matches;
          const fallbacks = { 'legacy-crt': legacy ?? 'on', 'reduced-motion': reducedMotion ? 'off' : 'on' };
          for (const { id, fallback } of effects) {
            d.dataset[id] = localStorage.getItem(`fx-${id}`) ?? fallbacks[fallback];
          }
        } catch {}
      })();
    </script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip visually-hidden" href="#main">{t('skip')}</a>
    <PixelField />
    <div class="crt-scan" aria-hidden="true"></div>
    <Header lang={lang} switchPath={langSwitchPath} />
    <main id="main" data-pagefind-body={type === 'article' ? '' : undefined}>
      <slot />
    </main>
    <Footer lang={lang} />
    <CommandPalette lang={lang} switchPath={langSwitchPath} />
    <DoomLauncher />
    {PUBLIC_ASSISTANT === 'on' && <Assistant lang={lang} />}
    <script is:inline>
      // Shortcut hints say Ctrl by default; Apple keyboards use Command.
      if (/Mac|iPhone|iPad/.test(navigator.userAgentData?.platform ?? navigator.platform)) {
        document.querySelectorAll('[data-mod]').forEach((el) => (el.textContent = '⌘'));
      }
    </script>
    {
      PUBLIC_CF_BEACON_TOKEN && (
        <script defer src="https://static.cloudflareinsights.com/beacon.min.js" data-cf-beacon={JSON.stringify({ token: PUBLIC_CF_BEACON_TOKEN })} />
      )
    }
    {
      // data-domains keeps PR previews and local builds out of the stats.
      PUBLIC_UMAMI_WEBSITE_ID && (
        <script defer src="https://cloud.umami.is/script.js" data-website-id={PUBLIC_UMAMI_WEBSITE_ID} data-domains={Astro.site?.hostname} />
      )
    }
  </body>
</html>

<style>
  .skip:focus {
    position: fixed !important; top: 0.5rem; left: 0.5rem; width: auto; height: auto; clip: auto; z-index: 100;
    padding: 0.6rem 1rem; background: var(--accent); color: var(--accent-ink);
  }
</style>
