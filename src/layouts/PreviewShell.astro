---
// Minimal document for the /editorial, /technical and /bold style previews.
// Deliberately does NOT load the retro design system (global.css, CRT layers).
interface Props { style: 'editorial' | 'technical' | 'bold' | 'alien' | 'bladerunner'; title: string }
const { style, title } = Astro.props;
const styles = ['editorial', 'technical', 'bold', 'alien', 'bladerunner'] as const;
---

<!doctype html>
<html lang="en" data-style={style}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex" />
    <title>{title}</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
  </head>
  <body>
    <div class="preview-bar">
      <span>Style preview: <strong>{style}</strong></span>
      <nav aria-label="Style previews">
        <a href="/">retro (live site)</a>
        {styles.map((s) => <a href={`/${s}`} aria-current={s === style ? 'page' : undefined}>{s}</a>)}
      </nav>
    </div>
    <slot />
  </body>
</html>

<style is:global>
  body { margin: 0; }
  .preview-bar {
    position: sticky; top: 0; z-index: 100;
    display: flex; justify-content: space-between; gap: 1rem; flex-wrap: wrap;
    padding: 0.5rem 1rem;
    font: 500 12px/1.4 ui-monospace, 'Cascadia Code', monospace;
    background: #111; color: #eee;
  }
  .preview-bar nav { display: flex; gap: 0.9rem; flex-wrap: wrap; }
  .preview-bar a { color: #bbb; }
  .preview-bar a[aria-current='page'] { color: #fff; font-weight: 700; }
</style>
