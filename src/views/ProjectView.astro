---
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Pager from '../components/Pager.astro';
import StatGrid from '../components/StatGrid.astro';
import Window from '../components/Window.astro';
import DemoFrame from '../components/DemoFrame.astro';
import ProjectClip from '../components/ProjectClip.astro';
import AreaChips from '../components/AreaChips.astro';
import { graph, breadcrumbLd, personLd, ogImageFor } from '../lib/seo';
import { type Lang, localize, useT, formatDate } from '../i18n/ui';
import { type Project, projectRepoStats, projectPeriod } from '../lib/content';

interface Props { project: Project; lang: Lang; prev?: Project; next?: Project }
const { project: p, lang, prev, next } = Astro.props;
const t = useT(lang);
const { Content } = await render(p);
const stats = projectRepoStats(p);
const period = projectPeriod(p, lang);
const readme = stats?.primary.readmeHtml;
const work = {
  '@type': stats ? 'SoftwareSourceCode' : 'CreativeWork',
  name: p.data.title,
  description: p.data.summary.en,
  url: new URL(`/projects/${p.id}`, Astro.site).toString(),
  creator: { '@id': `${Astro.site}#person` },
  keywords: p.data.stack.join(', '),
  ...(stats && { codeRepository: stats.primary.url, programmingLanguage: stats.languages.map((l) => l.name) }),
};
const ld = graph(work, personLd(Astro.site), breadcrumbLd(Astro.site, [['Projects', '/projects'], [p.data.title, `/projects/${p.id}`]]));
---

<Base lang={lang} title={p.data.title} description={p.data.summary[lang]} type="article" jsonLd={ld} ogImage={ogImageFor('projects', p.id)}>
  <article>
    <PageHead
      as="header"
      back={{ href: localize('/projects', lang), label: t('project.back') }}
      eyebrow={t(`projects.cat.${p.data.category}`)}
      glyph={p.data.glyph}
      title={p.data.title}
      lede={p.data.tagline[lang]}
    >
      <AreaChips areas={p.data.areas} lang={lang} />
      <div class="actions">
        {p.data.live && <a class="btn btn--primary" href={p.data.live} rel="noopener">{t('project.live')} ↗</a>}
        {stats && <a class="btn" href={stats.primary.url} rel="noopener">{t('project.repo')} ↗</a>}
        {stats && stats.repos.slice(1).map((r) => <a class="btn" href={r.url} rel="noopener">{r.name} ↗</a>)}
      </div>
    </PageHead>

    <div class="wrap layout">
      <aside class="meta">
        <Window title="info.sys">
          <dl class="mono">
            <dt>{t('project.role')}</dt><dd>{p.data.role}</dd>
            <dt>{t('project.when')}</dt><dd>{period}</dd>
            <dt>{t('project.context')}</dt><dd>{p.data.context}</dd>
            {p.data.grade && (<><dt>{t('project.grade')}</dt><dd><span class="badge badge--accent">{p.data.grade}</span></dd></>)}
            {stats && (
              <>
                <dt>GitHub</dt>
                <dd>{stats.stars > 0 && `★ ${stats.stars} ${t('project.stars')} · `}{t('project.updated')} {formatDate(new Date(stats.pushedAt), lang)}</dd>
              </>
            )}
          </dl>
          {stats && stats.languages.length > 0 && (
            <div class="langs" aria-label="Languages">
              <div class="langbar">
                {stats.languages.map((l) => <span style={`flex:${l.share};background:${l.color ?? 'var(--fg-faint)'}`} title={`${l.name} ${(l.share * 100).toFixed(1)}%`}></span>)}
              </div>
              <ul class="mono">
                {stats.languages.slice(0, 5).map((l) => <li><i style={`background:${l.color ?? 'var(--fg-faint)'}`}></i>{l.name} <span class="faint">{(l.share * 100).toFixed(0)}%</span></li>)}
              </ul>
            </div>
          )}
          {!stats && <p class="faint small mono private">{t('project.private')}</p>}
        </Window>
        <div class="stack">
          <h2 class="mono label-h">{t('project.stack')}</h2>
          <ul class="chips">{p.data.stack.map((s) => <li class="chip">{s}</li>)}</ul>
          {stats && stats.primary.topics.length > 0 && (
            <ul class="chips topics">{stats.primary.topics.slice(0, 12).map((s) => <li class="chip">#{s}</li>)}</ul>
          )}
        </div>
      </aside>

      <div class="main">
        {p.data.metrics.length > 0 && (
          <StatGrid class="project-stats" stats={p.data.metrics.map((m) => ({ value: m.value, label: m.label[lang] }))} />
        )}

        <p class="summary">{p.data.summary[lang]}</p>

        {p.data.video && <ProjectClip base={p.data.video} label={p.id} />}

        {p.data.demo && <DemoFrame src={p.data.demo} title={p.data.title} lang={lang} />}

        <section class="prose" aria-label={t('project.casestudy')}>
          {lang === 'da' && <p class="note mono">{t('project.en_only')}</p>}
          <Content />
        </section>

        {readme && (
          <details class="readme-box win">
            <summary class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__title">README.md - {stats!.primary.name}</span><span class="win__meta">▼</span></summary>
            <div class="win__body prose readme" set:html={readme} />
          </details>
        )}
      </div>
    </div>

    <Pager
      label="Projects"
      prev={prev && { href: localize(`/projects/${prev.id}`, lang), label: prev.data.title }}
      next={next && { href: localize(`/projects/${next.id}`, lang), label: next.data.title }}
    />
  </article>
</Base>

<style>
  .actions { display: flex; flex-wrap: wrap; gap: 0.7rem; margin-top: 0.5rem; }
  .layout { display: grid; grid-template-columns: 19rem 1fr; gap: clamp(1.5rem, 4vw, 3.5rem); align-items: start; }
  .meta { position: sticky; top: 5rem; display: grid; gap: 1.5rem; }
  dl { display: grid; gap: 0.2rem; margin: 0; font-size: 0.8rem; }
  dt {
    color: var(--fg-faint); text-transform: uppercase; font-size: 0.68rem; letter-spacing: 0.06em; margin-top: 0.6rem;
  }
  dt:first-child { margin-top: 0; }
  dd { margin: 0; }
  .langs { margin-top: 1.2rem; }
  .langbar { display: flex; height: 0.6rem; border: 1px solid var(--line); gap: 1px; background: var(--line); }
  .langs ul { list-style: none; padding: 0; margin: 0.6rem 0 0; font-size: 0.75rem; display: grid; gap: 0.2rem; }
  .langs li { display: flex; align-items: center; gap: 0.45rem; }
  .langs i { width: 0.55rem; height: 0.55rem; display: inline-block; }
  .private { margin-top: 1rem; }
  .topics { margin-top: 0.5rem; }
  .topics .chip { color: var(--accent-2); border-style: dashed; }
  :global(.project-stats) { margin-bottom: 2rem; }
  .summary { font-size: 1.15rem; line-height: 1.6; max-width: 44rem; margin-bottom: 2rem; }
  .note { font-size: 0.8rem; color: var(--fg-faint); border: 1px dashed var(--line); padding: 0.5rem 0.8rem; }
  .readme-box { margin-top: 3rem; }
  .readme-box summary { cursor: pointer; list-style: none; }
  .readme-box summary::-webkit-details-marker { display: none; }
  .readme-box[open] .win__meta { transform: rotate(180deg); }
  @media (max-width: 900px) {
    .layout { grid-template-columns: 1fr; }
    .meta { position: static; }
  }
</style>
