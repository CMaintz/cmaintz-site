---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Window from '../components/Window.astro';
import { type Lang, localize, useT } from '../i18n/ui';
import { services, workLanguages, process, HOURLY_RATE_DKK } from '../data/services';
import { values } from '../data/values';
import { faq } from '../data/faq';
import { graph, personLd, offerCatalogLd, faqLd, breadcrumbLd } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const ld = graph(
  personLd(Astro.site),
  offerCatalogLd(Astro.site, lang),
  faqLd(lang),
  breadcrumbLd(Astro.site, [[t('services.title'), localize('/services', lang)]]),
);
---

<Base lang={lang} title={t('services.title')} description={t('services.lede')} jsonLd={ld}>
  <PageHead eyebrow="~/services" title={t('services.title')} lede={t('services.lede')} />

  <section class="wrap">
    <div class="grid grid-2">
      {services.map((s) => <ServiceCard service={s} lang={lang} />)}
    </div>
  </section>

  <section class="wrap section two">
    <Window title="pricing.txt" class="reveal">
      <h2>{t('services.pricing')}</h2>
      <p class="price glow">{HOURLY_RATE_DKK} <span>DKK / h</span></p>
      <p class="dim">{t('services.pricing.body').replace('{rate}', String(HOURLY_RATE_DKK))}</p>
    </Window>
    <div>
      <h2 class="mono label-h">{t('services.languages')}</h2>
      <ul class="chips">{workLanguages.map((l) => <li class="chip">{l}</li>)}</ul>
      <h2 class="mono label-h spaced">{t('services.process')}</h2>
      <ol class="steps">
        {process[lang].map((p, i) => (
          <li><span class="n mono">{String(i + 1).padStart(2, '0')}</span><div><strong>{p.step}</strong><p class="dim">{p.body}</p></div></li>
        ))}
      </ol>
    </div>
  </section>

  <section class="wrap section faq" aria-labelledby="faq-h">
    <h2 id="faq-h" class="mono label-h">{t('services.faq')}</h2>
    <dl>
      {faq[lang].map(({ q, a }) => (
        <div><dt>{q}</dt><dd class="dim">{a}</dd></div>
      ))}
    </dl>
  </section>

  <section class="wrap values mono" aria-label={t('about.values')}>
    <span class="faint">{t('about.values')}:</span>
    {values.map((v) => <a href={localize('/about', lang) + '#values-h'}>◆ {v.title[lang]}</a>)}
  </section>

  <section class="wrap cta">
    <a class="btn btn--primary" href={localize('/contact', lang) + '?topic=freelance'}>{t('services.ask')} <span class="arrow">→</span></a>
  </section>
</Base>

<style>
  .two { display: grid; grid-template-columns: 1fr 1.2fr; gap: 3rem; align-items: start; }
  .price { font: 800 3.5rem var(--font-sans); color: var(--accent); letter-spacing: -0.04em; margin-block: 0.4rem; }
  .price span { font: 500 1rem var(--font-mono); color: var(--fg-dim); letter-spacing: 0; }
  .spaced { margin-top: 2rem; }
  .steps { list-style: none; padding: 0; margin: 0; display: grid; gap: 1rem; }
  .steps li { display: grid; grid-template-columns: 2.5rem 1fr; gap: 0.8rem; }
  .steps .n { color: var(--accent); font-size: 0.9rem; padding-top: 0.15rem; }
  .values { display: flex; flex-wrap: wrap; gap: 0.6rem 1.4rem; font-size: 0.82rem; margin-bottom: 2.5rem; }
  .values a { color: var(--accent); text-decoration: none; }
  .cta { text-align: center; }
  .faq dl { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr)); gap: 1.5rem 3rem; margin: 0; }
  .faq dt { font-weight: 700; margin-bottom: 0.35rem; }
  .faq dd { margin: 0; }
  @media (max-width: 860px) { .two { grid-template-columns: 1fr; } }
</style>
