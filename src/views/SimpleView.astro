---
// Shared shell for small text pages (/now, /uses).
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import { type Lang } from '../i18n/ui';

interface Props { lang: Lang; title: string; eyebrow: string; lede: string; updated?: string }
const { lang, title, eyebrow, lede, updated } = Astro.props;
---

<Base lang={lang} title={title} description={lede}>
  <PageHead eyebrow={eyebrow} title={title} lede={lede}>
    {updated && <p class="mono faint small">{updated}</p>}
  </PageHead>
  <section class="wrap"><slot /></section>
</Base>

<style>
</style>
