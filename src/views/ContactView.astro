---
import { PUBLIC_TURNSTILE_SITE_KEY } from 'astro:env/client';
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Window from '../components/Window.astro';
import { type Lang, useT } from '../i18n/ui';
import { site } from '../data/site';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const topics = ['job', 'freelance', 'consulting', 'other'] as const;
---

<Base lang={lang} title={t('contact.title')} description={t('contact.lede')}>
  {PUBLIC_TURNSTILE_SITE_KEY && <script slot="head" src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>}
  <PageHead eyebrow="~/contact" title={t('contact.title')} lede={t('contact.lede')} />

  <section class="wrap layout">
    <Window title="new_message.eml" meta="✉">
      <form class="form" method="post" action="/api/contact" data-contact data-email={site.email}>
        <div class="row2">
          <label>{t('contact.name')}<input class="field" name="name" required maxlength="120" autocomplete="name" /></label>
          <label>{t('contact.email')}<input class="field" name="email" type="email" required maxlength="200" autocomplete="email" /></label>
        </div>
        <div class="row2">
          <label>{t('contact.company')}<input class="field" name="company" maxlength="120" autocomplete="organization" /></label>
          <label>{t('contact.topic')}
            <select class="field" name="topic">{topics.map((k) => <option value={k}>{t(`contact.topic.${k}`)}</option>)}</select>
          </label>
        </div>
        <label>{t('contact.budget')}<input class="field" name="budget" maxlength="80" /></label>
        <label>{t('contact.message')}<textarea class="field" name="message" required minlength="10" maxlength="5000" rows="7"></textarea></label>
        <label class="hp" aria-hidden="true">Website<input name="website" tabindex="-1" autocomplete="off" /></label>
        {PUBLIC_TURNSTILE_SITE_KEY && <div class="cf-turnstile" data-sitekey={PUBLIC_TURNSTILE_SITE_KEY} data-theme="auto"></div>}
        <div class="submit">
          <button class="btn btn--primary" type="submit" data-label={t('contact.send')} data-busy={t('contact.sending')}>{t('contact.send')} <span class="arrow">→</span></button>
          <p class="faint small">{t('contact.privacy')}</p>
        </div>
        <p class="status mono" role="status" aria-live="polite" data-ok={t('contact.ok')} data-err={t('contact.err')}></p>
      </form>
    </Window>

    <aside class="direct">
      <h2 class="mono label-h">{t('contact.direct')}</h2>
      <a class="big" href={`mailto:${site.email}`}>{site.email}</a>
      <a class="mono" href={site.socials.github}>GitHub ↗</a>
      {site.socials.linkedin && <a class="mono" href={site.socials.linkedin}>LinkedIn ↗</a>}
      <p class="mono faint small">{site.location} · CET/CEST</p>
    </aside>
  </section>
</Base>

<script>
  const form = document.querySelector<HTMLFormElement>('form[data-contact]');
  const status = form?.querySelector<HTMLElement>('.status');
  const button = form?.querySelector<HTMLButtonElement>('button[type=submit]');

  function presetTopic() {
    const topic = new URLSearchParams(location.search).get('topic');
    const select = form?.querySelector('select');
    if (topic && select?.querySelector(`option[value="${CSS.escape(topic)}"]`)) select.value = topic;
  }

  function setBusy(busy: boolean) {
    button!.disabled = busy;
    button!.textContent = busy ? button!.dataset.busy! : button!.dataset.label!;
  }

  /** Fallback when sending fails: write to me directly. */
  const mailtoLink = () => Object.assign(document.createElement('a'), { href: `mailto:${form!.dataset.email}`, textContent: form!.dataset.email! });

  function showResult(ok: boolean) {
    status!.dataset.state = ok ? 'ok' : 'err';
    status!.textContent = ok ? status!.dataset.ok! : `${status!.dataset.err} `;
    if (!ok) status!.append(mailtoLink());
  }

  async function post(data: FormData) {
    const res = await fetch('/api/contact', { method: 'POST', body: data, headers: { accept: 'application/json' } });
    return res.ok;
  }

  async function onSubmit(e: SubmitEvent) {
    e.preventDefault();
    setBusy(true);
    const ok = await post(new FormData(form!)).catch(() => false);
    setBusy(false);
    showResult(ok);
    if (ok) form!.reset();
  }

  /** No-JS posts redirect back with ?sent or ?error; reflect that in the status line. */
  function showRedirectResult() {
    const q = new URLSearchParams(location.search);
    if (q.has('sent') || q.has('error')) showResult(q.has('sent'));
  }

  presetTopic();
  showRedirectResult();
  form?.addEventListener('submit', onSubmit);
</script>

<style>
  .layout { display: grid; grid-template-columns: 1.6fr 1fr; gap: 3rem; align-items: start; }
  .form { display: grid; gap: 1rem; }
  .row2 { display: grid; grid-template-columns: 1fr 1fr; gap: 1rem; }
  label {
    display: grid; gap: 0.35rem; font: 500 0.75rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em;
    color: var(--fg-dim);
  }
  .hp { position: absolute; left: -9999px; }
  .submit { display: flex; gap: 1rem; align-items: center; flex-wrap: wrap; }
  .status { font-size: 0.85rem; min-height: 1.2em; }
  .status[data-state='ok'] { color: var(--ok); }
  .status[data-state='err'] { color: var(--warn); }
  .direct { display: grid; gap: 0.7rem; }
  .big { font: 700 1.3rem var(--font-sans); color: var(--accent); word-break: break-all; }
  .direct a.mono { text-decoration: none; color: var(--fg-dim); }
  @media (max-width: 860px) { .layout, .row2 { grid-template-columns: 1fr; } }
</style>
