---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import PostItem from '../components/PostItem.astro';
import { type Lang, localize, useT } from '../i18n/ui';
import { type Post, getPosts, allTags } from '../lib/content';

interface Props { lang: Lang; tag?: string; posts?: Post[] }
const { lang, tag } = Astro.props;
const t = useT(lang);
const all = await getPosts();
const posts = Astro.props.posts ?? all;
const tags = allTags(all);
const title = tag ? `${t('blog.tagged')} #${tag}` : t('blog.title');
---

<Base lang={lang} title={title} description={t('blog.lede')}>
  <PageHead eyebrow={`~/blog${tag ? `/tags/${tag}` : ''}`} title={title} lede={t('blog.lede')}>
    <p class="links mono">
      <a href="/rss.xml">◉ {t('blog.rss')}</a>
      <a href={localize('/search', lang)}>⌕ {t('nav.search')}</a>
      {lang === 'da' && <span class="faint">{t('blog.en_only')}</span>}
    </p>
  </PageHead>
  <section class="wrap layout">
    <div>
      {posts.length ? posts.map((p) => <PostItem post={p} lang={lang} />) : <p class="dim">{t('blog.empty')}</p>}
      {tag && <p class="mono back"><a href={localize('/blog', lang)}>← {t('blog.back')}</a></p>}
    </div>
    <aside class="tags">
      <h2 class="mono">{t('blog.tags')}</h2>
      <ul class="chips">
        {tags.map(([name, n]) => (
          <li><a class:list={['chip', { 'chip--accent': name === tag }]} href={localize(`/blog/tags/${name}`, lang)}>#{name} <span class="faint">{n}</span></a></li>
        ))}
      </ul>
    </aside>
  </section>
</Base>

<style>
  .links { display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: 0.82rem; }
  .links a { color: var(--accent); text-decoration: none; }
  .layout { display: grid; grid-template-columns: 1fr 15rem; gap: 3rem; align-items: start; }
  .tags { position: sticky; top: 5rem; }
  .tags h2 { font-size: 0.75rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-faint); margin-bottom: 0.8rem; }
  .back { margin-top: 2rem; font-size: 0.85rem; }
  @media (max-width: 800px) { .layout { grid-template-columns: 1fr; } .tags { position: static; order: -1; } }
</style>
