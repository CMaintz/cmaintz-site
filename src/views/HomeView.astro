---
import Base from '../layouts/Base.astro';
import Window from '../components/Window.astro';
import WhoamiTerminal from '../components/WhoamiTerminal.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { type Lang, localize, useT } from '../i18n/ui';
import { getFeaturedProjects, getPosts } from '../lib/content';
import { site } from '../data/site';
import { AREA_IDS, areas } from '../data/areas';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const featured = await getFeaturedProjects(9);
const posts = (await getPosts()).slice(0, 3);
const focus = AREA_IDS.map((k, i) => ({
  id: k,
  n: String(i + 1).padStart(2, '0'),
  title: t(`focus.${k}.title`),
  body: t(`focus.${k}.body`),
  glyph: areas[k].glyph,
}));
const stack = ['TypeScript', 'Java', 'C#', 'PHP', 'Kotlin', 'Swift', 'Python', 'Spring Boot', 'Symfony', 'Angular', 'React', 'Astro', 'GitHub Actions', 'mise', 'Docker', 'PostgreSQL', 'RabbitMQ', 'Cloudflare', 'Azure', 'Kubernetes', 'Claude Code', 'Semgrep'];
---

<Base lang={lang}>
  <section class="hero wrap">
    <div class="hero__text">
      <a class="status mono" href={localize('/contact', lang)}><span class="status-dot" aria-hidden="true"></span> {t('home.status')} · {site.location}</a>
      <h1 class="glow">{t('home.hello').replace('.', '')}<span class="cursor" aria-hidden="true"></span></h1>
      <p class="lede">{t('home.lede')}</p>
      <div class="ctas">
        <a class="btn btn--primary" href={localize('/projects', lang)}>{t('home.cta.work')} <span class="arrow">→</span></a>
        <a class="btn" href={localize('/contact', lang)}>{t('home.cta.hire')}</a>
        <button class="btn btn--ghost kb mono" type="button" data-cmdk-open><kbd data-mod>Ctrl</kbd>+<kbd>K</kbd></button>
      </div>
    </div>

    <WhoamiTerminal lang={lang} />
  </section>

  <section class="section wrap" aria-labelledby="focus-h">
    <div class="section-head">
      <h2 id="focus-h"><span class="idx">01</span>{t('home.focus')}</h2>
    </div>
    <div class="grid focus">
      {focus.map((f) => (
        <a class="focus__item reveal" href={localize(`/what-i-do/${f.id}`, lang)}>
          <span class="focus__glyph" aria-hidden="true">{f.glyph}</span>
          <h3>{f.title}</h3>
          <p class="dim">{f.body}</p>
          <span class="focus__more mono">{t('wid.more')} →</span>
        </a>
      ))}
    </div>
  </section>

  <section class="section wrap" aria-labelledby="work-h">
    <div class="section-head">
      <h2 id="work-h"><span class="idx">02</span>{t('home.featured')}</h2>
      <a class="btn btn--sm" href={localize('/projects', lang)}>{t('home.all_projects')} <span class="arrow">→</span></a>
    </div>
    <div class="grid grid-3">
      {featured.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
    </div>
  </section>

  <section class="marquee" aria-label={t('home.stack')}>
    <div class="marquee__track mono" aria-hidden="true">
      {[...stack, ...stack].map((s) => <span>{s}<i>✦</i></span>)}
    </div>
    <p class="visually-hidden">{stack.join(', ')}</p>
  </section>

  <section class="section wrap" aria-labelledby="posts-h">
    <div class="section-head">
      <h2 id="posts-h"><span class="idx">03</span>{t('home.latest')}</h2>
      <a class="btn btn--sm" href={localize('/blog', lang)}>{t('home.all_posts')} <span class="arrow">→</span></a>
    </div>
    <div>{posts.map((p) => <PostItem post={p} lang={lang} />)}</div>
  </section>

  <section class="wrap">
    <Window title="inquiry.txt" meta="↵" class="cta reveal">
      <div class="cta__inner">
        <div>
          <h2>{t('home.cta.title')}</h2>
          <p class="dim">{t('home.cta.body')}</p>
        </div>
        <div class="ctas">
          <a class="btn btn--primary" href={localize('/contact', lang)}>{t('nav.contact')} <span class="arrow">→</span></a>
          <a class="btn" href={localize('/services', lang)}>{t('nav.services')}</a>
        </div>
      </div>
    </Window>
  </section>
</Base>

<style>
  .hero {
    display: grid; grid-template-columns: 1.25fr 1fr; gap: clamp(2rem, 5vw, 4rem); align-items: center;
    padding-block: clamp(1.5rem, 4vw, 3rem) clamp(2rem, 5vw, 4rem);
  }
  .status {
    display: inline-flex; align-items: center; gap: 0.6rem; font-size: 0.8rem; text-transform: uppercase;
    letter-spacing: 0.06em; color: var(--fg-dim); border: 1px solid var(--line); padding: 0.3rem 0.7rem;
    background: var(--bg-2); margin-bottom: 1.5rem; text-decoration: none;
  }
  .status:hover { color: var(--accent); border-color: var(--accent); }
  /* The hero's bottom padding is the gap before the first section. */
  .hero + .section { padding-top: 0; }
  h1 { margin-bottom: 1.4rem; }
  .ctas { display: flex; flex-wrap: wrap; gap: 0.8rem; margin-top: 2rem; align-items: center; }
  /* The logo's glitch, played once per hover. */
  .ctas .btn--primary:hover { animation: jiggle 300ms steps(3) 1; }
  @keyframes jiggle {
    33% { transform: translate(-2px, 1px); }
    66% { transform: translate(2px, -1px); filter: hue-rotate(60deg); }
  }
  .kb { font-size: 0.75rem; color: var(--fg-dim); gap: 0.3rem; }
  @media (hover: none) and (pointer: coarse) { .kb { display: none; } }

  /* Five areas: one row when wide, three over two in between, then a column.
     Each box draws its top and left dashes and is pulled 1px up and left, so the
     outer ones tuck under the frame and only the inner dividers show. */
  .focus {
    grid-template-columns: repeat(5, 1fr); gap: 0; border: 2px solid var(--line); background: var(--bg-2);
    overflow: hidden;
  }
  .focus__item {
    padding: 1.5rem; border-left: 1px dashed var(--line); border-top: 1px dashed var(--line); margin: -1px 0 0 -1px;
    display: flex; flex-direction: column; gap: 0.6rem;
  }
  .focus__glyph { font-size: 1.4rem; color: var(--accent); text-shadow: var(--glow); }
  .focus__item { text-decoration: none; color: inherit; transition: background 120ms; }
  .focus__item:hover { background: var(--bg-3); color: inherit; }
  .focus__item:hover h3 { color: var(--accent); }
  .focus__more { margin-top: auto; font-size: 0.75rem; color: var(--accent); }
  .focus__item h3 { font-size: 1.1rem; }
  .focus__item p { font-size: 0.93rem; }
  @media (max-width: 1100px) {
    .focus { grid-template-columns: repeat(6, 1fr); }
    .focus__item { grid-column: span 2; }
    .focus__item:nth-last-child(-n + 2) { grid-column: span 3; }
  }
  @media (max-width: 640px) {
    .focus { grid-template-columns: 1fr; }
    .focus__item, .focus__item:nth-last-child(-n + 2) { grid-column: auto; }
  }

  .marquee {
    position: relative; z-index: 1; overflow: hidden; border-block: 2px solid var(--line); background: var(--bg-2);
    padding: 0.9rem 0; margin-block: 1rem;
  }
  .marquee__track { display: flex; width: max-content; gap: 0; font-size: 0.9rem; color: var(--fg-dim); }
  .marquee__track span {
    display: inline-flex; align-items: center; gap: 1.4rem; padding-right: 1.4rem; white-space: nowrap;
  }
  .marquee__track i { font-style: normal; color: var(--accent); }
  @media (prefers-reduced-motion: no-preference) { .marquee__track { animation: marquee 60s linear infinite; } }
  @keyframes marquee { to { transform: translateX(-50%); } }

  .cta__inner {
    display: flex; justify-content: space-between; align-items: center; gap: 2rem; flex-wrap: wrap;
    padding: 1rem 0.5rem;
  }
  .cta__inner h2 { margin-bottom: 0.5rem; }
  .cta__inner .ctas { margin-top: 0; }

  @media (max-width: 860px) { .hero { grid-template-columns: 1fr; } }
</style>
