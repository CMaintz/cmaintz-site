---
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { type Lang, useT, formatDate } from '../i18n/ui';
import { getProjects, github } from '../lib/content';
import { AREA_IDS, areaLabels } from '../data/areas';
import { LANGUAGES, stackLanguages, techId } from '../lib/tech';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const projects = await getProjects();
const cats = ['professional', 'open-source', 'personal', 'academic'] as const;
const counts = Object.fromEntries(cats.map((c) => [c, projects.filter((p) => p.data.category === c).length]));
const langCounts = LANGUAGES.map((l) => ({ id: techId(l), name: l, n: projects.filter((p) => stackLanguages(p.data.stack).includes(l)).length }));
// Most-used first; languages no project uses don't get a button.
const langs = langCounts.filter((l) => l.n > 0).sort((a, b) => b.n - a.n);
const aiCount = projects.filter((p) => p.data.aiPowered).length;
const areaCounts = Object.fromEntries(AREA_IDS.map((a) => [a, projects.filter((p) => (p.data.areas as string[]).includes(a)).length]));
---

<Base lang={lang} title={t('projects.title')} description={t('projects.lede')}>
  <PageHead eyebrow="~/projects" title={t('projects.title')} lede={t('projects.lede')}>
    <p class="mono faint small">{t('footer.synced')}: {formatDate(new Date(github.syncedAt), lang)} · {github.repos.length} public repos</p>
  </PageHead>

  <section class="wrap">
    <div class="filters mono" role="toolbar" aria-label="Filter">
      <button type="button" data-filter="all" aria-pressed="true">{t('projects.filter.all')} <span>{projects.length}</span></button>
      {cats.map((c) => <button type="button" data-filter={c} aria-pressed="false">{t(`projects.cat.${c}`)} <span>{counts[c]}</span></button>)}
    </div>
    <div class="filters areas mono" role="toolbar" aria-label={lang === 'da' ? 'Områder' : 'Areas'}>
      {AREA_IDS.map((a) => <button type="button" data-filter={a} aria-pressed="false">◆ {areaLabels[a][lang]} <span>{areaCounts[a]}</span></button>)}
    </div>
    <div class="filters tech mono" role="toolbar" aria-label={t('projects.filter.tech')}>
      <button type="button" data-filter="ai-powered" aria-pressed="false">{t('projects.filter.ai')} <span>{aiCount}</span></button>
      {langs.map((l) => <button type="button" data-filter={l.id} aria-pressed="false">{l.name} <span>{l.n}</span></button>)}
    </div>
    <div class="grid grid-3" data-projects>
      {projects.map((p, i) => <ProjectCard project={p} lang={lang} index={i} />)}
    </div>
  </section>
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const cards = document.querySelectorAll<HTMLElement>('[data-projects] > [data-category]');
  const tagged = (c: HTMLElement, f: string) => [c.dataset.areas, c.dataset.tech].some((v) => (v ?? '').split(' ').includes(f));
  const matches = (c: HTMLElement, f: string) => f === 'all' || c.dataset.category === f || tagged(c, f);
  const pressButton = (f: string) => buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === f)));
  const filterCards = (f: string) => cards.forEach((c) => (c.hidden = !matches(c, f)));
  const setHash = (f: string) => history.replaceState(null, '', f === 'all' ? location.pathname : `#${f}`);
  const apply = (f: string) => {
    pressButton(f);
    filterCards(f);
    setHash(f);
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  addEventListener('hashchange', () => apply(location.hash.slice(1) || 'all'));
  const initial = location.hash.slice(1);
  if (initial && [...buttons].some((b) => b.dataset.filter === initial)) apply(initial);
</script>

<style>
  .filters { display: flex; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 0.8rem; }
  .filters.tech { margin-bottom: 2rem; }
  .filters.areas button { color: var(--accent); }
  .filters button { font: 500 0.82rem var(--font-mono); background: var(--bg-2); color: var(--fg-dim); border: 1px solid var(--line); padding: 0.45rem 0.8rem; cursor: pointer; }
  .filters button span { color: var(--fg-faint); margin-left: 0.3rem; }
  .filters button:hover { border-color: var(--accent); color: var(--fg); }
  .filters button[aria-pressed='true'] { background: var(--accent); border-color: var(--accent); color: var(--accent-ink); }
  .filters button[aria-pressed='true'] span { color: inherit; opacity: 0.7; }
  [hidden] { display: none !important; }
</style>
