---
// One "What I do" area: matching services, principles, related projects and posts.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import ServiceCard from '../components/ServiceCard.astro';
import Window from '../components/Window.astro';
import ProjectCard from '../components/ProjectCard.astro';
import PostItem from '../components/PostItem.astro';
import { type Lang, localize, useT } from '../i18n/ui';
import { AREA_IDS, areas, type AreaId } from '../data/areas';
import { services } from '../data/services';
import { getProjects, projectsInArea, postsInArea } from '../lib/content';
import { graph, breadcrumbLd, personLd, ogImageFor } from '../lib/seo';

interface Props { lang: Lang; area: AreaId }
const { lang, area } = Astro.props;
const t = useT(lang);
const a = areas[area];
const projects = await projectsInArea(area);
const posts = await postsInArea(area, lang);
const offers = services.filter((s) => s.areas.includes(area));
const titles = new Map((await getProjects()).map((p) => [p.id, p.data.title]));
const others = AREA_IDS.filter((id) => id !== area);
// One grid row up front; each "show more" adds the next row so a long list doesn't bury the page.
// The script sizes a row from the live column count; ROW is only the first paint's guess.
const ROW = 3;
// Numbered from what renders, so a hidden section leaves no gap.
const sections = [offers.length > 0 && 'offer', 'how', projects.length > 0 && 'built', posts.length > 0 && 'writing'];
const idx = (id: string) => String(sections.filter(Boolean).indexOf(id) + 1).padStart(2, '0');
const ld = graph(
  { '@type': 'Service', name: a.label.en, description: a.intro.en, provider: { '@id': `${Astro.site}#person` }, areaServed: 'DK' },
  personLd(Astro.site),
  breadcrumbLd(Astro.site, [['What I do', '/#focus-h'], [a.label.en, `/what-i-do/${area}`]]),
);
---

<Base lang={lang} title={a.label[lang]} description={a.intro[lang]} jsonLd={ld} ogImage={ogImageFor('areas', area)}>
  <PageHead
    back={{ href: localize('/#focus-h', lang), label: t('wid.title') }}
    eyebrow={`~/what-i-do/${area}`}
    glyph={a.glyph}
    title={a.label[lang]}
    lede={a.intro[lang]}
  />

  {offers.length > 0 && (
    <section class="wrap section" aria-labelledby="offer-h">
      <div class="section-head"><h2 id="offer-h"><span class="idx">{idx('offer')}</span>{t('wid.for_you')}</h2></div>
      <div class="grid grid-2">
        {offers.map((s) => <ServiceCard service={s} lang={lang} deliverables={false} level={3} />)}
      </div>
      <p class="cta"><a class="btn btn--primary" href={localize('/contact', lang) + '?topic=consulting'}>{t('wid.hire')} <span class="arrow">→</span></a>
        <a class="btn" href={localize('/services', lang)}>{t('nav.services')}</a></p>
    </section>
  )}

  <section class="wrap section" aria-labelledby="how-h">
    <div class="section-head"><h2 id="how-h"><span class="idx">{idx('how')}</span>{t('wid.how')}</h2></div>
    <div class="grid grid-2">
      {a.principles.map((p, i) => (
        <Window title={`rule_${String(i + 1).padStart(2, '0')}.txt`} class="reveal" as="article">
          <h3>{p.title[lang]}</h3>
          <p class="dim body">{p.body[lang]}</p>
          {!!p.proof?.length && (
            <p class="proof mono">{t('wid.seen_in')}: {p.proof.map((slug, j) => (
              <>{j > 0 && ' · '}<a href={localize(`/projects/${slug}`, lang)}>{titles.get(slug)} →</a></>
            ))}</p>
          )}
        </Window>
      ))}
    </div>
  </section>

  {projects.length > 0 && (
    <section class="wrap section" aria-labelledby="built-h">
      <div class="section-head"><h2 id="built-h"><span class="idx">{idx('built')}</span>{t('wid.built')}</h2></div>
      <div class="grid grid-3 built">
        {projects.map((p, i) => <ProjectCard project={p} lang={lang} index={i} compact collapsed={i >= ROW} />)}
      </div>
      {projects.length > ROW && (
        <button type="button" class="more mono" data-show-more data-label={t('wid.show_more')} hidden>
          {t('wid.show_more').replace('{n}', String(projects.length - ROW))}
        </button>
      )}
    </section>
  )}

  {posts.length > 0 && (
    <section class="wrap section" aria-labelledby="writing-h">
      <div class="section-head"><h2 id="writing-h"><span class="idx">{idx('writing')}</span>{t('wid.writing')}</h2></div>
      {posts.map((p) => <PostItem post={p} lang={lang} />)}
    </section>
  )}

  <nav class="wrap others mono" aria-label={t('wid.other')}>
    <span class="faint">{t('wid.other')}:</span>
    {others.map((id) => <a href={localize(`/what-i-do/${id}`, lang)}>{areas[id].glyph} {areas[id].label[lang]}</a>)}
  </nav>
</Base>

<script>
  // Shows whole rows of the grid in place; the button follows the grid, so it ends up under the new row.
  for (const btn of document.querySelectorAll<HTMLButtonElement>('[data-show-more]')) {
    const grid = btn.previousElementSibling as HTMLElement;
    const cards = [...grid.children] as HTMLElement[];
    // The grid auto-fits, so the column count depends on the viewport; collapsed tracks still count.
    const cols = () => getComputedStyle(grid).gridTemplateColumns.split(' ').length;
    const showUpTo = (n: number) => {
      cards.forEach((card, i) => card.toggleAttribute('data-collapsed', i >= n));
      const left = Math.max(cards.length - n, 0);
      btn.hidden = left === 0;
      btn.textContent = btn.dataset.label!.replace('{n}', String(left));
    };
    showUpTo(cols());
    btn.addEventListener('click', () => {
      const shown = cards.findIndex((card) => card.hasAttribute('data-collapsed'));
      const step = cols();
      showUpTo((Math.floor(shown / step) + 1) * step);
      cards[shown]?.querySelector('a')?.focus();
    });
  }
</script>

<style>
  h3 { font-size: 1.2rem; margin-bottom: 0.5rem; }
  .body { font-size: 0.97rem; }
  .proof { margin-top: 0.9rem; font-size: 0.78rem; color: var(--fg-faint); }
  .proof a { color: var(--accent); text-decoration: none; }
  /* Without JS every card shows and the button stays hidden. */
  :global(.js) .built > :global([data-collapsed]) { display: none; }
  .more {
    margin-top: 1.5rem; cursor: pointer; font: inherit; font-size: 0.85rem; color: var(--fg-dim); background: none;
    padding: 0.6rem 0.9rem; border: 1px dashed var(--line);
  }
  .more:hover { color: var(--accent); border-color: var(--accent); }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; margin-top: 1.8rem; }
  .others {
    display: flex; gap: 1.2rem; flex-wrap: wrap; font-size: 0.85rem; padding-top: 1.5rem;
    border-top: 2px dashed var(--line);
  }
  .others a { color: var(--fg-dim); text-decoration: none; }
  .others a:hover { color: var(--accent); }
</style>
