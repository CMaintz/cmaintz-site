---
// The "What I do" hub: every area with its intro and first few rules, linking to its own page.
import Base from '../layouts/Base.astro';
import PageHead from '../components/PageHead.astro';
import Window from '../components/Window.astro';
import { type Lang, localize, useT } from '../i18n/ui';
import { AREA_IDS, areas } from '../data/areas';
import { graph, breadcrumbLd, personLd } from '../lib/seo';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
// Enough rules to show each area's angle; the area page has the rest.
const PREVIEW = 3;
const ld = graph(personLd(Astro.site), breadcrumbLd(Astro.site, [['What I do', '/what-i-do']]));
---

<Base lang={lang} title={t('wid.title')} description={t('wid.lede')} jsonLd={ld}>
  <PageHead eyebrow="~/what-i-do" title={t('wid.title')} lede={t('wid.lede')} />

  <section class="wrap section stack" style="--stack: 1.5rem" aria-label={t('wid.title')}>
    {AREA_IDS.map((id) => {
      const a = areas[id];
      const href = localize(`/what-i-do/${id}`, lang);
      return (
        <Window title={`~/what-i-do/${id}`} meta={`${a.principles.length} ${t('wid.rules')}`} as="article" class="reveal" bodyClass="area">
          <div>
            <h2><a href={href}><span class="glyph" aria-hidden="true">{a.glyph}</span>{a.label[lang]}</a></h2>
            <p class="dim">{a.intro[lang]}</p>
          </div>
          <div>
            <ul class="rules mono">{a.principles.slice(0, PREVIEW).map((p) => <li>{p.title[lang]}</li>)}</ul>
            <a class="btn btn--sm" href={href}>{t('wid.more')} <span class="arrow">→</span></a>
          </div>
        </Window>
      );
    })}
  </section>

  <section class="wrap section">
    <p class="cta"><a class="btn btn--primary" href={localize('/services', lang)}>{t('nav.services')} <span class="arrow">→</span></a>
      <a class="btn" href={localize('/contact', lang)}>{t('wid.hire')}</a></p>
  </section>
</Base>

<style>
  .stack :global(.area) { display: grid; grid-template-columns: 1.3fr 1fr; gap: 2rem; align-items: start; }
  h2 { font-size: 1.4rem; margin-bottom: 0.6rem; }
  h2 a { color: inherit; text-decoration: none; display: inline-flex; gap: 0.7rem; align-items: center; }
  h2 a:hover { color: var(--accent); }
  .glyph { color: var(--accent); }
  .rules { list-style: none; padding: 0; margin: 0 0 1.2rem; font-size: 0.85rem; color: var(--fg-dim); }
  .rules li { padding: 0.45rem 0; border-bottom: 1px dashed var(--line); }
  .rules li::before { content: '> '; color: var(--accent); }
  .cta { display: flex; gap: 0.8rem; flex-wrap: wrap; }
  @media (max-width: 760px) { .stack :global(.area) { grid-template-columns: 1fr; gap: 1rem; } }
</style>
