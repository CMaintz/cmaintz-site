---
import 'katex/dist/katex.min.css';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Comments from '../components/Comments.astro';
import { type Lang, useT, formatDate } from '../i18n/ui';
import { type Post, readingTime } from '../lib/content';
import { site } from '../data/site';

interface Props { post: Post; lang: Lang; prev?: Post; next?: Post }
const { post, lang, prev, next } = Astro.props;
const t = useT(lang);
const { Content, headings } = await render(post);
const toc = headings.filter((h) => h.depth === 2);
const mins = readingTime(post.body);
const ld = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: site.name, url: Astro.site?.toString() },
  inLanguage: post.data.lang,
};
---

<Base lang={post.data.lang} title={post.data.title} description={post.data.description} type="article" alternates={false} langSwitchPath="/blog" publishedTime={post.data.pubDate} jsonLd={ld}>
  <div class="progress" aria-hidden="true"></div>
  <article class="wrap">
    <header class="head">
      <a class="back mono" href="/blog">← {t('blog.back')}</a>
      <p class="meta mono">
        <time datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang, { year: 'numeric', month: 'long', day: 'numeric' })}</time>
        <span>·</span><span>{mins} {t('blog.read')}</span>
        {post.data.updatedDate && <><span>·</span><span>{t('blog.updated')} {formatDate(post.data.updatedDate, lang)}</span></>}
      </p>
      <h1 class="glow">{post.data.title}</h1>
      <p class="lede">{post.data.description}</p>
      <ul class="chips">{post.data.tags.map((tag) => <li><a class="chip" href={`/blog/tags/${tag}`}>#{tag}</a></li>)}</ul>
    </header>

    <div class="layout">
      <div class="prose" data-pagefind-body>
        <Content />
      </div>
      {toc.length > 2 && (
        <nav class="toc mono" aria-label={t('blog.toc')}>
          <p class="faint">{t('blog.toc')}</p>
          <ol>{toc.map((h) => <li><a href={`#${h.slug}`}>{h.text}</a></li>)}</ol>
        </nav>
      )}
    </div>

    {post.data.comments && <Comments lang={lang} slug={post.id} />}

    <nav class="pager mono" aria-label="Posts">
      {prev ? <a href={`/blog/${prev.id}`}>← {prev.data.title}</a> : <span></span>}
      {next ? <a href={`/blog/${next.id}`}>{next.data.title} →</a> : <span></span>}
    </nav>
  </article>
</Base>

<style>
  .progress { position: fixed; top: 0; left: 0; right: 0; height: 3px; background: var(--accent); transform-origin: 0 50%; z-index: 60; transform: scaleX(0); }
  @supports (animation-timeline: scroll()) {
    .progress { animation: grow linear both; animation-timeline: scroll(root); }
  }
  @keyframes grow { to { transform: scaleX(1); } }
  .head { max-width: 50rem; padding-block: clamp(2.5rem, 6vw, 4.5rem) 2.5rem; display: grid; gap: 1rem; }
  .back { font-size: 0.82rem; color: var(--fg-dim); text-decoration: none; }
  .meta { display: flex; gap: 0.6rem; flex-wrap: wrap; font-size: 0.8rem; color: var(--fg-faint); }
  h1 { font-size: clamp(2.2rem, 5vw, 3.6rem); }
  .layout { display: grid; grid-template-columns: minmax(0, 44rem) 1fr; gap: 3rem; align-items: start; }
  .toc { position: sticky; top: 5rem; font-size: 0.8rem; border-left: 2px solid var(--line); padding-left: 1rem; }
  .toc ol { list-style: none; padding: 0; margin: 0.6rem 0 0; display: grid; gap: 0.45rem; }
  .toc a { text-decoration: none; color: var(--fg-dim); }
  .toc a:hover { color: var(--accent); }
  .pager { display: flex; justify-content: space-between; gap: 1rem; margin-top: 3rem; padding-top: 1.5rem; border-top: 2px dashed var(--line); font-size: 0.85rem; }
  .pager a { text-decoration: none; color: var(--fg-dim); }
  .pager a:hover { color: var(--accent); }
  @media (max-width: 1000px) { .layout { grid-template-columns: minmax(0, 1fr); } .toc { display: none; } }
</style>
