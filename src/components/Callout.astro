---
interface Props { type?: 'note' | 'tip' | 'warn'; title?: string }
const { type = 'note', title } = Astro.props;
const icon = { note: 'i', tip: '★', warn: '!' }[type];
---

<aside class:list={['callout', type]}>
  <span class="icon pixel" aria-hidden="true">{icon}</span>
  <div>
    {title && <p class="t">{title}</p>}
    <slot />
  </div>
</aside>

<style>
  .callout {
    display: grid; grid-template-columns: auto 1fr; gap: 0.9rem; padding: 0.9rem 1.1rem; border: 2px solid var(--c);
    background: color-mix(in srgb, var(--c) 9%, var(--bg-2)); box-shadow: 4px 4px 0 var(--shadow-c);
  }
  .note { --c: var(--accent-2); }
  .tip { --c: var(--accent); }
  .warn { --c: var(--warn); }
  .icon {
    width: 1.6rem; height: 1.6rem; display: grid; place-items: center; background: var(--c); color: #111;
    font-size: 0.8rem;
  }
  .t { font: 600 0.85rem var(--font-mono); text-transform: uppercase; letter-spacing: 0.05em; margin-bottom: 0.25rem; }
  .callout :global(p) { margin: 0; }
</style>
