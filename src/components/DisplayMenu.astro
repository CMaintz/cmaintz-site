---
// Header dropdown for the retro display effects, each on its own switch:
// scanlines, the glow on accent text, the vignette and the background animation.
// Each is a data-* flag on <html>, stored as fx-<name> and set before first
// paint by Base.astro; listeners hear `fxchange`.
import { type Lang, useT } from '../i18n/ui';

interface Props { lang: Lang }
const t = useT(Astro.props.lang);
const effects = ['scan', 'glow', 'vignette', 'motion'] as const;
---

<details class="fx">
  <summary class="tool" aria-label={t('fx.menu')} title={t('fx.menu')}>
    <svg viewBox="0 0 16 16" width="16" height="16" aria-hidden="true" shape-rendering="crispEdges"><path fill="currentColor" d="M1 3h14v9H1zM2 4v7h12V4zM5 13h6v1H5z M3 5h10v1H3zM3 7h10v1H3zM3 9h10v1H3z" /></svg>
  </summary>
  <div class="fx__panel win mono">
    <p class="fx__head">{t('fx.menu')}</p>
    {effects.map((e) => (
      <label><input type="checkbox" data-fx={e} checked /> {t(`fx.${e}`)}</label>
    ))}
  </div>
</details>

<script>
  const root = document.documentElement;
  const menu = document.querySelector<HTMLDetailsElement>('details.fx')!;
  const boxes = menu.querySelectorAll<HTMLInputElement>('[data-fx]');

  function set(box: HTMLInputElement) {
    const key = box.dataset.fx!;
    const value = box.checked ? 'on' : 'off';
    root.dataset[key] = value;
    try { localStorage.setItem(`fx-${key}`, value); } catch {}
    dispatchEvent(new CustomEvent('fxchange'));
  }

  boxes.forEach((b) => {
    b.checked = root.dataset[b.dataset.fx!] !== 'off';
    b.addEventListener('change', () => set(b));
  });
  // Close when clicking anywhere else, like a native menu.
  document.addEventListener('click', (e) => { if (!menu.contains(e.target as Node)) menu.open = false; });
</script>

<style>
  .fx { position: relative; }
  .fx summary { list-style: none; }
  .fx summary::-webkit-details-marker { display: none; }
  .fx[open] summary { color: var(--accent); border-color: var(--accent); }
  .fx__panel { position: absolute; right: 0; top: calc(100% + 0.6rem); min-width: 14rem; padding: 0.6rem 0.8rem; display: grid; gap: 0.5rem; font-size: 0.85rem; z-index: 2; }
  .fx__head { margin: 0 0 0.2rem; font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-faint); }
  label { display: flex; align-items: center; gap: 0.55rem; cursor: pointer; color: var(--fg); }
  label:hover { color: var(--accent); }
  input { accent-color: var(--accent); width: 1rem; height: 1rem; margin: 0; }
</style>
