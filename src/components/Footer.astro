---
import { type Lang, localize, useT, formatDate } from '../i18n/ui';
import { site } from '../data/site';
import { github } from '../lib/content';

interface Props { lang: Lang }
const { lang } = Astro.props;
const t = useT(lang);
const synced = formatDate(new Date(github.syncedAt), lang);
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="wrap cols">
    <div class="who">
      <p class="pixel big">{site.name}</p>
      <p class="dim">{site.role[lang]}</p>
      <p class="dim mono small">{site.location}</p>
    </div>
    <nav aria-label="Footer" class="links mono">
      <a href={localize('/about', lang)}>{t('nav.about')}</a>
      <a href={localize('/projects', lang)}>{t('nav.projects')}</a>
      <a href={localize('/blog', lang)}>{t('nav.blog')}</a>
      <a href={localize('/services', lang)}>{t('nav.services')}</a>
      <a href={localize('/contact', lang)}>{t('nav.contact')}</a>
      <a href={localize('/now', lang)}>{t('nav.now')}</a>
      <a href={localize('/uses', lang)}>{t('nav.uses')}</a>
      <a href={localize('/cv', lang)}>{t('nav.cv')}</a>
      <a href="/rss.xml">rss</a>
    </nav>
    <div class="ext mono">
      <a href={`mailto:${site.email}`}>{site.email}</a>
      <a href={site.socials.github} rel="me">github.com/CMaintz ↗</a>
      {site.socials.linkedin && <a href={site.socials.linkedin} rel="me">LinkedIn ↗</a>}
      <span class="faint small">{t('footer.styles')}: <a href="/technical">technical</a> · <a href="/alien">alien</a> · <a href="/bladerunner">bladerunner</a></span>
    </div>
  </div>
  <div class="statusbar mono">
    <div class="wrap row">
      <span><span class="status-dot" aria-hidden="true"></span> SYS OK</span>
      <span class="hide-sm">{t('footer.synced')}: {synced}</span>
      <span class="hide-sm">{t('footer.built')}</span>
      <span class="clock" data-clock>AAR --:--</span>
      <span>© {year}</span>
    </div>
  </div>
</footer>

<script>
  const el = document.querySelector<HTMLElement>('[data-clock]');
  if (el) {
    const fmt = new Intl.DateTimeFormat('en-GB', { hour: '2-digit', minute: '2-digit', timeZone: 'Europe/Copenhagen' });
    const tick = () => (el.textContent = `AAR ${fmt.format(new Date())}`);
    tick();
    setInterval(tick, 30_000);
  }
</script>

<style>
  .site-footer { position: relative; z-index: 1; margin-top: 4rem; border-top: 2px solid var(--line); background: color-mix(in srgb, var(--bg) 88%, transparent); }
  .cols { display: grid; grid-template-columns: 1.2fr 1fr 1.4fr; gap: 2rem; padding-block: 2.5rem; }
  .big { font-size: 1.05rem; margin-bottom: 0.3rem; }
  .small { font-size: 0.8rem; }
  .links { display: grid; grid-template-columns: repeat(3, auto); gap: 0.35rem 1.2rem; align-content: start; font-size: 0.85rem; }
  .links a, .ext a { text-decoration: none; color: var(--fg-dim); }
  .links a:hover, .ext a:hover { color: var(--accent); }
  .ext { display: flex; flex-direction: column; gap: 0.4rem; font-size: 0.85rem; align-items: flex-start; }
  .ext .small a { color: var(--fg-dim); text-decoration: underline; }
  .statusbar { border-top: 1px solid var(--line); background: var(--bg-2); font-size: 0.72rem; color: var(--fg-dim); text-transform: uppercase; letter-spacing: 0.05em; }
  .row { display: flex; gap: 1.5rem; justify-content: space-between; padding-block: 0.45rem; flex-wrap: wrap; }
  .row > span { display: inline-flex; gap: 0.5rem; align-items: center; }
  @media (max-width: 760px) {
    .cols { grid-template-columns: 1fr; }
    .hide-sm { display: none !important; }
  }
</style>
