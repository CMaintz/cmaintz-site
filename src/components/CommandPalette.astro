---
import { type Lang, localize, unlocalize, useT } from '../i18n/ui';
import { getProjects, getPosts, github } from '../lib/content';
import { site } from '../data/site';
import { AREA_IDS, areas } from '../data/areas';

interface Props { lang: Lang; switchPath?: string }
const { lang, switchPath } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'da' : 'en';
const here = unlocalize(Astro.url.pathname);

const pages = (['/', '/about', '/projects', '/blog', '/services', '/contact', '/now', '/uses', '/cv', '/search'] as const).map((p) => ({
  group: 'go',
  label: p === '/' ? t('nav.home') : t(`nav.${p.slice(1)}` as Parameters<typeof t>[0]),
  hint: localize(p, lang),
  href: localize(p, lang),
}));
const allProjects = await getProjects();
const projects = allProjects.map((p) => ({ group: t('nav.projects'), label: p.data.title, hint: p.data.tagline[lang], alias: [p.id, ...p.data.repos].join(' '), href: localize(`/projects/${p.id}`, lang) }));
const areaItems = AREA_IDS.map((id) => ({ group: t('wid.title'), label: areas[id].label[lang], hint: areas[id].intro[lang], href: localize(`/what-i-do/${id}`, lang) }));
const posts = (await getPosts()).map((p) => ({ group: t('nav.blog'), label: p.data.title, hint: p.data.description, href: `/blog/${p.id}` }));
const actions = [
  { group: 'run', label: t('theme.toggle'), hint: 'theme', action: 'theme' },
  ...(['scan', 'glow', 'vignette', 'motion'] as const).map((k) => ({ group: 'run', label: `${t('fx.menu')}: ${t(`fx.${k}`)}`, hint: 'crt', action: `fx:${k}` })),
  { group: 'run', label: `${t('lang.label')}: ${other.toUpperCase()}`, hint: 'lang', href: localize(switchPath ?? here, other) },
  { group: 'run', label: lang === 'da' ? 'Kopiér e-mail' : 'Copy email address', hint: site.email, action: 'copy-email' },
  { group: 'run', label: 'GitHub', hint: site.socials.github, href: site.socials.github },
  // Hidden: only appears when one of its hint words is typed in full.
  { group: 'secret', label: 'DOOM (1993)', hint: 'doom iddqd idkfa', action: 'doom' },
];
// Public repos without a project page: typing their name goes to GitHub.
const repoItems = github.repos
  .filter((r) => !allProjects.some((p) => p.data.repos.includes(r.name)))
  .map((r) => ({ group: 'repo', label: r.name, hint: r.url.replace('https://', ''), href: r.url }));
const items = [...pages, ...areaItems, ...projects, ...repoItems, ...posts, ...actions];
---

<dialog class="cmdk win" aria-label={t('cmd.open')} data-items={JSON.stringify(items)} data-email={site.email}>
  <div class="win__bar"><span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span><span class="win__title">command.exe</span><span class="win__meta">esc</span></div>
  <div class="cmdk__body">
    <label class="prompt">
      <span class="accent mono" aria-hidden="true">&gt;</span>
      <input type="text" aria-describedby="cmdk-help" placeholder={t('cmd.hint')} autocomplete="off" spellcheck="false" role="combobox" aria-expanded="true" aria-controls="cmdk-list" aria-autocomplete="list" />
    </label>
    <ul id="cmdk-list" role="listbox"></ul>
    <p id="cmdk-help" class="help mono"><kbd>↑</kbd><kbd>↓</kbd> {lang === 'da' ? 'vælg' : 'select'} · <kbd>Tab</kbd> {lang === 'da' ? 'udfyld' : 'complete'} · <kbd>Enter</kbd> {lang === 'da' ? 'kør' : 'run'} · <kbd>Esc</kbd> {lang === 'da' ? 'luk' : 'close'}</p>
  </div>
</dialog>

<script>
  import { matchScore } from '../lib/palette-match';

  type Item = { group: string; label: string; hint?: string; alias?: string; href?: string; action?: string };
  const dlg = document.querySelector<HTMLDialogElement>('dialog.cmdk')!;
  const input = dlg.querySelector('input')!;
  const list = dlg.querySelector('ul')!;
  const items: Item[] = JSON.parse(dlg.dataset.items ?? '[]');
  let results: Item[] = [];
  let sel = 0;

  /** Exact name or alias (slug, repo name) wins outright; otherwise label, alias, then hint. */
  function rank(q: string, it: Item) {
    // Secrets never fuzzy-match: only a full keyword from the hint reveals them.
    if (it.group === 'secret') return (it.hint ?? '').split(' ').includes(q) ? 1000 : -1;
    const names = [it.label.toLowerCase(), ...(it.alias ?? '').split(' ')];
    if (names.includes(q)) return 1000;
    return Math.max(matchScore(q, it.label), matchScore(q, it.alias ?? '') - 1, matchScore(q, it.hint ?? '', false) - 5);
  }

  function search(q: string): Item[] {
    if (!q) return items.filter((i) => i.group === 'go' || i.group === 'run');
    return items
      .map((it) => ({ it, s: rank(q, it) }))
      .filter((r) => r.s >= 0)
      .sort((a, b) => b.s - a.s)
      .slice(0, 12)
      .map((r) => r.it);
  }

  /** Markup for one result row (text only, never HTML from the item). */
  function optionElement(r: Item, idx: number) {
    const li = document.createElement('li');
    li.role = 'option';
    li.id = `cmdk-${idx}`;
    li.innerHTML = `<span class="g"></span><span class="l"></span><span class="h"></span>`;
    li.querySelector('.g')!.textContent = r.group;
    li.querySelector('.l')!.textContent = r.label;
    li.querySelector('.h')!.textContent = r.hint ?? '';
    return li;
  }

  function interactiveOption(r: Item, idx: number) {
    const li = optionElement(r, idx);
    li.addEventListener('click', () => run(r));
    li.addEventListener('mousemove', () => select(idx));
    return li;
  }

  function updateResults() {
    results = search(input.value.trim().toLowerCase());
    sel = Math.min(sel, Math.max(0, results.length - 1));
  }

  function render() {
    list.replaceChildren(...results.map(interactiveOption));
    mark();
  }

  function refresh() {
    updateResults();
    render();
  }

  function mark() {
    [...list.children].forEach((li, i) => (li.ariaSelected = String(i === sel)));
    list.children[sel]?.scrollIntoView({ block: 'nearest' });
    input.setAttribute('aria-activedescendant', results.length ? `cmdk-${sel}` : '');
  }

  function select(idx: number) {
    if (sel === idx) return;
    sel = idx;
    mark();
  }

  function move(step: number) {
    const n = Math.max(1, results.length);
    select((sel + step + n) % n);
  }

  function runAction(action?: string) {
    if (action === 'theme') document.querySelector<HTMLButtonElement>('[data-theme-toggle]')?.click();
    if (action?.startsWith('fx:')) document.querySelector<HTMLInputElement>(`[data-fx="${action.slice(3)}"]`)?.click();
    if (action === 'copy-email') navigator.clipboard?.writeText(dlg.dataset.email ?? '');
    if (action === 'doom') dispatchEvent(new CustomEvent('doom:open'));
  }

  function perform(r: Item) {
    if (r.href) location.href = r.href;
    else runAction(r.action);
  }

  function run(r: Item) {
    dlg.close();
    perform(r);
  }

  function reset() {
    input.value = '';
    sel = 0;
    refresh();
  }

  function open() {
    reset();
    dlg.showModal();
    input.focus();
  }

  function toggle() {
    if (dlg.open) dlg.close();
    else open();
  }

  const isTyping = (t: EventTarget | null) => t instanceof HTMLInputElement || t instanceof HTMLTextAreaElement;

  /** Ctrl/Cmd+K anywhere, or "/" when not typing in a field. */
  function isPaletteShortcut(e: KeyboardEvent) {
    const cmdK = e.key.toLowerCase() === 'k' && (e.metaKey || e.ctrlKey);
    const slash = e.key === '/' && !dlg.open && !isTyping(e.target);
    return cmdK || slash;
  }

  function onGlobalKey(e: KeyboardEvent) {
    if (!isPaletteShortcut(e)) return;
    e.preventDefault();
    toggle();
  }

  /** Tab completes the input to the highlighted entry, like a shell. */
  function complete() {
    if (!results[sel]) return;
    input.value = results[sel].label;
    sel = 0;
    refresh();
  }

  function onInputKey(e: KeyboardEvent) {
    const handlers: Record<string, () => void> = {
      ArrowDown: () => move(1),
      ArrowUp: () => move(-1),
      Tab: complete,
      Enter: () => results[sel] && run(results[sel]),
    };
    if (!handlers[e.key]) return;
    e.preventDefault();
    handlers[e.key]();
  }

  document.querySelectorAll('[data-cmdk-open]').forEach((b) => b.addEventListener('click', open));
  addEventListener('keydown', onGlobalKey);
  input.addEventListener('input', () => { sel = 0; refresh(); });
  input.addEventListener('keydown', onInputKey);
  dlg.addEventListener('click', (e) => { if (e.target === dlg) dlg.close(); });
</script>

<style>
  .cmdk {
    width: min(40rem, calc(100vw - 2rem));
    padding: 0; margin: 12vh auto auto;
    color: var(--fg);
  }
  .cmdk::backdrop { background: rgb(0 0 0 / 0.55); backdrop-filter: blur(2px); }
  .cmdk[open] { animation: pop 140ms steps(4); }
  @keyframes pop { from { clip-path: inset(0 0 100% 0); } to { clip-path: inset(0); } }
  .cmdk__body { padding: 0.75rem; }
  @media (hover: none) and (pointer: coarse) { .help { display: none !important; } }
  .help { margin: 0.6rem 0 0; font-size: 0.7rem; color: var(--fg-faint); display: flex; gap: 0.35rem; align-items: center; flex-wrap: wrap; }
  .prompt { display: flex; gap: 0.6rem; align-items: center; border: 2px solid var(--line); padding: 0.55rem 0.75rem; background: var(--bg); }
  .prompt input { flex: 1; background: none; border: 0; outline: 0; color: var(--fg); font: 500 1rem var(--font-mono); min-width: 0; }
  ul { list-style: none; margin: 0.6rem 0 0; padding: 0; max-height: 50vh; overflow-y: auto; }
  ul :global(li) { display: grid; grid-template-columns: 5.5rem 1fr; gap: 0 0.8rem; padding: 0.5rem 0.6rem; cursor: pointer; border: 1px solid transparent; }
  ul :global(li .g) { grid-row: span 2; font: 400 0.65rem var(--font-pixel); text-transform: uppercase; color: var(--fg-faint); padding-top: 0.25rem; }
  ul :global(li .l) { font-weight: 600; }
  ul :global(li .h) { font: 0.78rem var(--font-mono); color: var(--fg-dim); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  @media (max-width: 600px) { ul :global(li) { grid-template-columns: 3.2rem 1fr; padding: 0.4rem 0.5rem; } }
  ul :global(li[aria-selected='true']) { background: var(--accent); color: var(--accent-ink); }
  ul :global(li[aria-selected='true'] .g), ul :global(li[aria-selected='true'] .h) { color: var(--accent-ink); opacity: 0.8; }
</style>
