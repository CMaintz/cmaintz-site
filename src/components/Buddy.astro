---
// Buddy, the site assistant (clips in src/data/buddy.ts). It renders his
// neutral pose; src/lib/buddy-sprite.ts animates it by moving --frame and
// --y across the atlas and gliding the sprite through the idle's float.
import { BUDDY_CLIPS, BUDDY_FRAME, BUDDY_SHEET } from '../data/buddy';

interface Props {
  /** Whole-number zoom, so the pixels stay square. */
  scale?: 1 | 2 | 3;
  class?: string;
}
const { scale = 1, class: cls } = Astro.props;

const idle = BUDDY_CLIPS.idle;
const box = [`--w: ${BUDDY_FRAME.width}px`, `--h: ${BUDDY_FRAME.height}px`, `--scale: ${scale}`].join('; ');
const sprite = [
  `--cw: ${idle.width}px`,
  `--ch: ${idle.height}px`,
  '--ox: 0px',
  '--oy: 0px',
  `--sheet: url(${BUDDY_SHEET.src})`,
  `--sheet-w: ${BUDDY_SHEET.width}px`,
  `--sheet-h: ${BUDDY_SHEET.height}px`,
  `--y: ${idle.y}px`,
  '--frame: 0',
].join('; ');
---

<span class:list={['buddy', cls]} style={box} data-buddy-sprite aria-hidden="true">
  <span class="buddy__clip" style={sprite}></span>
</span>

<style>
  /* The box keeps the idle frame's size in the layout; clips that roam past
     it (the swim) draw a bigger frame that overflows it, anchored so he
     starts and ends exactly where he idles. */
  .buddy {
    position: relative;
    display: block;
    width: calc(var(--w) * var(--scale));
    height: calc(var(--h) * var(--scale));
  }
  .buddy__clip {
    position: absolute;
    left: calc(var(--ox) * var(--scale) * -1);
    top: calc(var(--oy) * var(--scale) * -1);
    width: calc(var(--cw) * var(--scale));
    height: calc(var(--ch) * var(--scale));
    background: var(--sheet) calc(var(--cw) * var(--frame) * var(--scale) * -1)
      calc(var(--y) * var(--scale) * -1) / calc(var(--sheet-w) * var(--scale))
      calc(var(--sheet-h) * var(--scale)) no-repeat;
    image-rendering: pixelated;
    /* A roaming frame is mostly empty; clicks there belong to the page, not to him. */
    pointer-events: none;
  }
</style>
