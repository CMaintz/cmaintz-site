---
// Portrait in the site's CRT frame. Source: public/img/christoffer.{webp,jpg}
// (640x800, cropped from the original with sharp).
interface Props { alt: string }
const { alt } = Astro.props;
---

<figure class="avatar">
  <picture>
    <source srcset="/img/christoffer.webp" type="image/webp" />
    <img src="/img/christoffer.jpg" alt={alt} width="640" height="800" loading="eager" decoding="async" />
  </picture>
</figure>

<style>
  .avatar {
    margin: 0; width: 15rem; aspect-ratio: 4 / 5;
    border: 2px solid var(--line-strong);
    box-shadow: 8px 8px 0 var(--shadow-c);
    position: relative; overflow: hidden;
    background: var(--bg-3);
  }
  :root:not([data-theme='light']) .avatar { border-color: #4a4a47; }
  img { width: 100%; height: 100%; object-fit: cover; }
  /* Subtle phosphor scanlines; they clear on hover so the photo reads naturally. */
  .avatar::after {
    content: ''; position: absolute; inset: 0; pointer-events: none;
    background: repeating-linear-gradient(to bottom, rgb(0 0 0 / 0.14) 0 1px, transparent 1px 3px);
    transition: opacity 300ms steps(3);
  }
  .avatar:hover::after { opacity: 0; }
  :root[data-scan='off'] .avatar::after { display: none; }
</style>
