---
// Easter egg: DOOM in a retro window. Opened by the `doom:open` event (the
// homepage terminal) or the Konami code. Nothing loads until it's opened.
---

<dialog class="doom win" aria-label="DOOM">
  <div class="win__bar">
    <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="win__title">doom.exe</span>
    <button class="win__meta close" type="button" aria-label="Close">✕ close</button>
  </div>
  <div class="screen" tabindex="-1" autofocus></div>
  <p class="hint mono">WASD move · ←→ turn · Space fire · E use · Shift run · Enter menu · <a href="/doom/NOTICE.txt">licences</a></p>
</dialog>

<script>
  const dlg = document.querySelector<HTMLDialogElement>('dialog.doom')!;
  const screen = dlg.querySelector('.screen')!;
  const KONAMI = ['ArrowUp', 'ArrowUp', 'ArrowDown', 'ArrowDown', 'ArrowLeft', 'ArrowRight', 'ArrowLeft', 'ArrowRight', 'b', 'a'];
  let progress = 0;

  // Touch-only devices can't play it; don't make them download 6.5 MB to find out.
  const keyboardless = () => matchMedia('(pointer: coarse)').matches && !matchMedia('(any-pointer: fine)').matches;

  function noKeyboard() {
    const msg = document.createElement('p');
    msg.className = 'nokb';
    msg.textContent = 'DOOM needs a keyboard. Come back on a computer and type "doom" again.';
    return msg;
  }

  function gameFrame() {
    const frame = document.createElement('iframe');
    frame.src = '/doom/';
    frame.title = 'DOOM';
    return frame;
  }

  /** The game, or a polite note on devices without a keyboard. */
  const screenContent = () => (keyboardless() ? noKeyboard() : gameFrame());

  function open() {
    const content = screenContent();
    screen.replaceChildren(content);
    dlg.showModal();
    content.focus();
  }

  /** Closing removes the iframe, which stops the game and frees its memory. */
  function close() {
    dlg.close();
    screen.replaceChildren();
  }

  /** Advances through the code; true when the last key completes it. */
  function konamiComplete(key: string) {
    progress = key === KONAMI[progress] ? progress + 1 : key === KONAMI[0] ? 1 : 0;
    if (progress < KONAMI.length) return false;
    progress = 0;
    return true;
  }

  const onKey = (e: KeyboardEvent) => konamiComplete(e.key) && open();

  addEventListener('doom:open', open);
  addEventListener('keydown', onKey);
  dlg.querySelector('.close')!.addEventListener('click', close);
  // Esc belongs to the game menu, so it must not close the window.
  dlg.addEventListener('cancel', (e) => e.preventDefault());
</script>

<style>
  .doom { width: min(960px, calc(100vw - 2rem)); padding: 0; margin: auto; color: var(--fg); }
  .doom::backdrop { background: rgb(0 0 0 / 0.75); }
  .close { background: var(--bg-3); border: 0; font: inherit; color: var(--fg); cursor: pointer; text-transform: uppercase; }
  .close:hover { color: var(--accent); }
  .screen { aspect-ratio: 4 / 3; background: #000; outline: none; }
  @media (pointer: coarse) { .hint { display: none; } }
  .screen :global(iframe) { width: 100%; height: 100%; border: 0; display: block; }
  .screen :global(.nokb) { margin: 0; height: 100%; display: grid; place-items: center; padding: 2rem; text-align: center; font: 1rem var(--font-mono); color: var(--accent); }
  .hint { font-size: 0.72rem; color: var(--fg-dim); padding: 0.5rem 0.8rem; margin: 0; border-top: 1px solid var(--line); }
  .hint a { color: var(--fg-dim); }
</style>
