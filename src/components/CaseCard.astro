---
// One case study, outcome first: the results, then problem and what was built,
// with a link to the project's full technical write-up.
import Window from './Window.astro';
import { type Lang, localize, useT } from '../i18n/ui';
import type { CaseStudy } from '../data/cases';

interface Props { study: CaseStudy; lang: Lang }
const { study: c, lang } = Astro.props;
const t = useT(lang);
---

<Window title={`case_${c.id}.md`} meta={c.context[lang]} as="article" class="case reveal">
  <h3 class="title">{c.title[lang]}</h3>
  <ul class="outcomes">{c.outcomes[lang].map((o) => <li>{o}</li>)}</ul>
  <dl>
    <dt class="mono">{t('services.case.problem')}</dt><dd class="dim">{c.problem[lang]}</dd>
    <dt class="mono">{t('services.case.solution')}</dt><dd class="dim">{c.solution[lang]}</dd>
  </dl>
  <a class="more mono" href={localize(`/projects/${c.project}`, lang)}>{t('services.case.read')} →</a>
</Window>

<style>
  .case :global(.win__body) { display: grid; gap: 0.9rem; height: 100%; grid-template-rows: auto auto 1fr auto; }
  .title { font-size: 1.2rem; margin: 0; }
  .outcomes { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; }
  .outcomes li { font-weight: 700; color: var(--fg); }
  .outcomes li::before { content: '▲ '; color: var(--accent); font-size: 0.8em; }
  dl { margin: 0; display: grid; gap: 0.3rem; }
  dt { font-size: 0.72rem; text-transform: uppercase; letter-spacing: 0.06em; color: var(--fg-faint); }
  dd { margin: 0 0 0.5rem; }
  .more { font-size: 0.82rem; color: var(--accent); text-decoration: none; }
</style>
