---
import { type Lang, localize, useT, formatDate, withSlash } from '../i18n/ui';
import { type Post, readingTime } from '../lib/content';

interface Props { post: Post; lang: Lang }
const { post, lang } = Astro.props;
const t = useT(lang);
const mins = readingTime(post.body);
---

<article class="post reveal">
  <time class="date mono" datetime={post.data.pubDate.toISOString()}>{formatDate(post.data.pubDate, lang)}</time>
  <div>
    <h3><a href={withSlash(`/blog/${post.id}`)}>{post.data.title}</a></h3>
    <p class="dim">{post.data.description}</p>
    <p class="meta mono">
      <span>{mins} {t('blog.read')}</span>
      {post.data.tags.map((tag) => <a class="tag" href={localize(`/blog/tags/${tag}`, lang)}>#{tag}</a>)}
      {post.data.draft && <span class="badge">draft</span>}
    </p>
  </div>
</article>

<style>
  .post { display: grid; grid-template-columns: 8.5rem 1fr; gap: 1.2rem; padding: 1.3rem 0; border-bottom: 1px dashed var(--line); }
  .date { font-size: 0.8rem; color: var(--fg-faint); padding-top: 0.3rem; }
  h3 { font-size: 1.3rem; margin-bottom: 0.35rem; }
  h3 a { text-decoration: none; background: linear-gradient(var(--accent), var(--accent)) 0 100% / 0 2px no-repeat; transition: background-size 250ms var(--ease); }
  h3 a:hover { background-size: 100% 2px; color: var(--fg); }
  .meta { display: flex; gap: 0.8rem; flex-wrap: wrap; font-size: 0.75rem; color: var(--fg-faint); margin-top: 0.5rem; }
  .tag { color: var(--accent-2); text-decoration: none; }
  .tag:hover { text-decoration: underline; }
  @media (max-width: 600px) { .post { grid-template-columns: 1fr; gap: 0.3rem; } }
</style>
