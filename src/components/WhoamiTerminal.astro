---
// Homepage terminal with two tabs: `whoami` (profile, every item a link) and
// `git log` (most recently pushed public repos, from the GitHub snapshot).
import Window from './Window.astro';
import { type Lang, localize, formatDate } from '../i18n/ui';
import { getProjects, github } from '../lib/content';
import { recentRepos } from '../lib/home';

interface Props { lang: Lang }
const { lang } = Astro.props;
const shipped = ['illux-product-ai', 'foundry', 'jev-tools', 'leash', 'jobbuddy', 'tech-atlas'];
const areas = [
  { id: 'backend', label: 'backend' },
  { id: 'devops', label: 'devops & dx' },
  { id: 'platform', label: 'platform' },
  { id: 'ai', label: 'ai enablement' },
];
const projectByRepo = new Map((await getProjects()).flatMap((p) => p.data.repos.map((r) => [r, p.id] as const)));
const synced = Date.parse(github.syncedAt);
const pushes = recentRepos(7).map((r) => ({
  name: r.name,
  lang: r.language?.name ?? '-',
  ago: `${Math.max(0, Math.round((synced - Date.parse(r.pushedAt)) / 86_400_000))}d`,
  href: projectByRepo.has(r.name) ? localize(`/projects/${projectByRepo.get(r.name)}`, lang) : r.url,
}));
const link = (path: string) => localize(path, lang);
---

<Window title="~/whoami" meta="tty1" class="term">
  <div class="tabs mono" role="tablist" aria-label="Terminal">
    <button type="button" role="tab" id="tab-whoami" aria-controls="panel-whoami" aria-selected="true">whoami</button>
    <button type="button" role="tab" id="tab-log" aria-controls="panel-log" aria-selected="false" tabindex="-1">git log</button>
  </div>

  <div class="term__body mono" role="tabpanel" id="panel-whoami" aria-labelledby="tab-whoami">
    <p><span class="accent">$</span> <span class="cmd">whoami</span></p>
    <p class="out"><a href={link('/about')}>christoffer maintz - developer, aarhus dk</a></p>
    <p><span class="accent">$</span> <span class="cmd">cat focus.txt</span></p>
    <p class="out">{areas.map((a, i) => <>{i > 0 && ' · '}<a href={link(`/what-i-do/${a.id}`)}>{a.label}</a></>)}</p>
    <p><span class="accent">$</span> <span class="cmd">ls ~/shipped</span></p>
    <p class="out hl">{shipped.map((s) => <><a href={link(`/projects/${s}`)}>{s}</a>{'  '}</>)}</p>
    <p><span class="accent">$</span> <span class="cmd">gh repo list --public | wc -l</span></p>
    <p class="out"><a href={github.profile.url}>{github.repos.length}</a></p>
    <p class="prompt"><span class="accent">$</span> <input type="text" aria-label="Terminal input" spellcheck="false" autocomplete="off" data-shell /></p>
    <p class="out reply" aria-live="polite" data-reply></p>
  </div>

  <div class="term__body mono" role="tabpanel" id="panel-log" aria-labelledby="tab-log" hidden>
    <p><span class="accent">$</span> <span class="cmd">git log --all-repos --latest</span></p>
    <ul class="log">
      {pushes.map((p) => <li><span class="ago">{p.ago}</span><a class="hl" href={p.href}>{p.name}</a><span class="lang">{p.lang}</span></li>)}
    </ul>
    <p class="note">synced {formatDate(new Date(github.syncedAt), lang)} · days since last push</p>
    <p><span class="accent">$</span> <span class="cursor"></span></p>
  </div>
</Window>

<script>
  const tabs = [...document.querySelectorAll<HTMLButtonElement>('.term [role="tab"]')];
  const panelOf = (tab: HTMLButtonElement) => document.getElementById(tab.getAttribute('aria-controls')!)!;

  // ── Tabs ──
  /** Marks one tab as current and shows only its panel. */
  function showTab(tab: HTMLButtonElement) {
    for (const t of tabs) {
      const on = t === tab;
      t.setAttribute('aria-selected', String(on));
      t.tabIndex = on ? 0 : -1;
      panelOf(t).hidden = !on;
    }
  }

  function select(tab: HTMLButtonElement) {
    showTab(tab);
    tab.focus();
    play(panelOf(tab));
  }

  function neighbourTab(current: HTMLButtonElement, step: number) {
    const i = tabs.indexOf(current);
    return tabs[(i + step + tabs.length) % tabs.length];
  }

  function onTabKey(e: KeyboardEvent) {
    if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
    select(neighbourTab(e.currentTarget as HTMLButtonElement, e.key === 'ArrowRight' ? 1 : -1));
  }

  tabs.forEach((t) => {
    t.addEventListener('click', () => select(t));
    t.addEventListener('keydown', onTabKey);
  });

  // ── The tiny shell on the last prompt. Mostly here for one secret command. ──
  const replies: Record<string, string> = {
    help: 'commands: whoami, ls, contact, help ... and maybe something from 1993',
    whoami: 'christoffer maintz',
    ls: 'illux-product-ai  foundry  jev-tools  leash  jobbuddy  tech-atlas',
    contact: 'christoffer@maintz.dev',
    doom: 'loading DOOM...',
    iddqd: 'loading DOOM...',
  };
  const DOOM_COMMANDS = new Set(['doom', 'iddqd']);

  const replyFor = (cmd: string) => replies[cmd] ?? (cmd ? `command not found: ${cmd}` : '');

  /** Next tick, so the Enter keypress can't land on the new window's buttons. */
  const openDoom = () => setTimeout(() => dispatchEvent(new CustomEvent('doom:open')));

  const shell = document.querySelector<HTMLInputElement>('[data-shell]');
  const reply = document.querySelector<HTMLElement>('[data-reply]');

  function execute(raw: string) {
    const cmd = raw.trim().toLowerCase();
    reply!.textContent = replyFor(cmd);
    if (DOOM_COMMANDS.has(cmd)) openDoom();
  }

  function onShellKey(e: KeyboardEvent) {
    if (e.key !== 'Enter') return;
    e.preventDefault();
    execute(shell!.value);
    shell!.value = '';
  }

  shell?.addEventListener('keydown', onShellKey);

  // ── Typing: commands appear character by character, output lines all at once. ──
  const CHAR_MS = 28;
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  const sleep = (ms: number) => new Promise((r) => setTimeout(r, ms));

  async function typeInto(el: HTMLElement) {
    const text = el.textContent ?? '';
    el.textContent = '';
    for (const ch of text) {
      el.textContent += ch;
      await sleep(CHAR_MS);
    }
  }

  async function playLine(line: HTMLElement) {
    line.classList.remove('pending');
    const cmd = line.querySelector<HTMLElement>('.cmd');
    if (cmd) await typeInto(cmd);
    await sleep(cmd ? 160 : 90);
  }

  const setPending = (lines: HTMLElement[], pending: boolean) => lines.forEach((l) => l.classList.toggle('pending', pending));

  async function play(panel: HTMLElement) {
    if (panel.dataset.played) return;
    panel.dataset.played = '1';
    const lines = [...panel.children] as HTMLElement[];
    setPending(lines, !reduce);
    if (reduce) return;
    for (const line of lines) await playLine(line);
  }

  play(panelOf(tabs[0]));
</script>

<style>
  .tabs { display: flex; gap: 0; margin: calc(-1 * clamp(1rem, 3vw, 1.6rem)) calc(-1 * clamp(1rem, 3vw, 1.6rem)) 1rem; border-bottom: 1px solid var(--line); }
  .tabs button { font: 500 0.78rem var(--font-mono); background: none; border: 0; border-right: 1px solid var(--line); color: var(--fg-dim); padding: 0.45rem 0.9rem; cursor: pointer; }
  .tabs button[aria-selected='true'] { background: var(--bg); color: var(--fg); box-shadow: inset 0 -2px 0 var(--accent); }
  .tabs button:hover { color: var(--accent); }
  .term__body { font-size: 0.85rem; line-height: 1.75; min-height: 15.5rem; }
  .term__body p { white-space: pre-wrap; word-break: break-word; }
  .term__body .out { color: var(--fg-dim); margin-bottom: 0.35rem; }
  .term__body a { color: inherit; text-decoration: none; }
  .hl a { display: inline-block; white-space: nowrap; }
  .term__body a:hover { color: var(--accent); text-decoration: underline; }
  .term__body .hl, .term__body .hl a { color: var(--accent-2); }
  .log { list-style: none; padding: 0; margin: 0.2rem 0 0.4rem; }
  .log li { display: grid; grid-template-columns: 3rem 1fr auto; gap: 0.8rem; }
  .ago { color: var(--fg-faint); }
  .lang { color: var(--fg-dim); }
  .note { color: var(--fg-faint); font-size: 0.72rem; }
  .prompt { display: flex; gap: 0.6ch; align-items: baseline; }
  .prompt input { flex: 1; min-width: 0; background: none; border: 0; outline: none; padding: 0; font: inherit; color: var(--fg); caret-color: var(--accent); caret-shape: block; }
  .reply:empty { display: none; }
  /* With JS, lines stay hidden until the typing script reveals them. */
  :global(.js) .term__body:not([data-played]) > * { visibility: hidden; }
  .term__body > .pending { visibility: hidden; }
</style>
