---
interface Props {
  title: string;
  meta?: string;
  as?: 'div' | 'section' | 'article' | 'aside';
  class?: string;
  bodyClass?: string;
}
const { title, meta, as: Tag = 'div', class: cls, bodyClass } = Astro.props;
---

<Tag class:list={['win', cls]}>
  <div class="win__bar" aria-hidden="true">
    <span class="win__dots" aria-hidden="true"><i></i><i></i><i></i></span>
    <span class="win__title">{title}</span>
    {meta && <span class="win__meta">{meta}</span>}
  </div>
  <div class:list={['win__body', bodyClass]}><slot /></div>
</Tag>
